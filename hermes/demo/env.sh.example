# Environment-specific values for the Hermes-on-Substrate PoC.
#
#   cp demo/env.sh.example demo/env.sh    # demo/env.sh is gitignored
#   $EDITOR demo/env.sh
#
# Every script in demo/ sources demo/env.sh. Nothing else in this repo hardcodes a
# project, a bucket or a registry - if you find one, it is a bug.
#
# These mirror the variables Substrate's own hack/ate-dev-env.sh.example uses, so if
# you installed Substrate on GKE you already chose most of them.

# --- your GCP project -------------------------------------------------------
export PROJECT_ID="your-project-id"
export CLUSTER_NAME="your-substrate-cluster"
export CLUSTER_LOCATION="us-central1-c"

# The scripts pin every kubectl and kubectl-ate call to the cluster named above,
# rather than trusting whatever context happens to be current. By default they look
# for the context `gcloud container clusters get-credentials` creates:
#
#   gke_${PROJECT_ID}_${CLUSTER_LOCATION}_${CLUSTER_NAME}
#
# If you have renamed your contexts, name yours here and it is used verbatim.
# export KUBECTL_CONTEXT="my-context-name"

# --- where images are pushed and pulled from --------------------------------
# Must be writable by you and readable by the cluster's nodes.
export REGISTRY="gcr.io/${PROJECT_ID}"
export ACTOR_IMAGE="${REGISTRY}/hermes-actor:v1"
export GATEWAY_IMAGE="${REGISTRY}/hermes-gateway:v1"

# --- where Substrate writes actor snapshots ---------------------------------
# You create this bucket yourself. Substrate's installer does NOT create it, whatever
# the name below suggests - that name is just the convention Substrate's own dev
# scripts use. Any bucket in your project will do:
#
#   gcloud storage buckets create "gs://snapshot-substrate-test-${PROJECT_ID}" \
#     --project="${PROJECT_ID}" --location=us-central1
#
# `atelet` is the identity that reads and writes snapshots - NOT ate-api-server - and
# it needs roles/storage.objectAdmin here. demo/README.md prerequisite 4 has the exact
# grant. Skipping it is the most common fresh-project failure, and it shows up far from
# its cause: an ActorTemplate that sits in ResumeGoldenActor forever.
#
# We keep Hermes snapshots under a hermes/ prefix so they are easy to find and to GC.
export SNAPSHOT_BUCKET="gs://snapshot-substrate-test-${PROJECT_ID}"
export SNAPSHOT_PREFIX="${SNAPSHOT_BUCKET}/hermes/"

# --- the ateom worker image -------------------------------------------------
# This is Substrate's own gVisor worker image, NOT something this repo builds - and
# NOT something the installer pushes into your registry for you. On a fresh project
# you publish it yourself, from a Substrate checkout:
#
#   cd /path/to/substrate
#   KO_DOCKER_REPO="${REGISTRY}/ate-images" go run github.com/google/ko build ./cmd/ateom-gvisor
#
# That prints the @sha256-pinned reference. Paste it below. The name is ko-generated
# (a content hash of the Go import path), so it reads as gibberish - but for a given
# Substrate revision it is the same string in every project, which is a useful check
# that you built the right thing.
#
# If you are joining a cluster where someone has already done this, you can instead
# read it off an existing WorkerPool. On a fresh install this returns nothing:
#
#   kubectl get workerpool -A \
#     -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name,IMAGE:.spec.ateomImage
#
# It MUST be @sha256-pinned.
export ATEOM_IMAGE="${REGISTRY}/ate-images/ateom-gvisor-REPLACE@sha256:REPLACE"

# PAUSE_IMAGE used to be set here. Substrate moved pauseImage off ActorTemplate, so
# nothing in this repo reads it any more and setting it does nothing at all.

# --- kubectl-ate ------------------------------------------------------------
# Substrate's CLI: `go install github.com/agent-substrate/substrate/cmd/kubectl-ate@latest`
# (or `go install ./cmd/kubectl-ate` from a checkout). Point this at the binary.
export ATE="${ATE:-$(command -v kubectl-ate || echo "$HOME/go/bin/kubectl-ate")}"

# --- demo knobs (safe defaults) ---------------------------------------------
export NS="${NS:-hermes}"
export ATESPACE="${ATESPACE:-hermes-demo}"

# --- the model backend ------------------------------------------------------
# All three are rendered into the ActorTemplate, and MODEL is rendered into the
# gateway too. They have to agree: the gateway's default silently wins over the
# actor's when they don't, so the turn goes to one model while the actor is
# configured for another.
#
# Hermes talks to any OpenAI-compatible endpoint. `custom` plus a base_url is
# how you point it at one; `gemini` is the other provider the entrypoint knows.
# Gemini here, matching demo/fleet/fleet.example.json and pass 1, which is what
# makes the two passes' numbers comparable.
export MODEL="${MODEL:-gemini-3.1-pro-preview}"
export MODEL_PROVIDER="${MODEL_PROVIDER:-gemini}"
export MODEL_BASE_URL="${MODEL_BASE_URL:-https://generativelanguage.googleapis.com}"

# The key itself is NEVER set here. It is read at deploy time from a file and
# put in the hermes-secrets Secret:
#   export MODEL_API_KEY_FILE="$HOME/.config/hermes/model.key"
