cmd_status() {
  load_env
  printf '%sproject%s   %s\n' "$C_DIM" "$C_X" "$PROJECT_ID"
  cluster_exists && ok "cluster $CLUSTER_NAME up" || warn "cluster not created"
  if cluster_exists; then
    kubectl get pods -n ate-system --no-headers 2>/dev/null | head -6 || warn "substrate not installed"
    echo
    kubectl get pods -n "$NAMESPACE" --no-headers 2>/dev/null || warn "gateway not deployed"
    echo
    # `list` is not a verb and never was; the mistake printed nothing and the
    # `| head` swallowed the usage error, so status just showed no actors.
    command -v kubectl-ate >/dev/null 2>&1 && kubectl-ate get actor -a "$ATESPACE" 2>/dev/null | head
  fi
}

cmd_smoke() {
  load_env
  check_stray_gateway || true
    say "running a core Hermes turn"
    kubectl exec -i -n "$NAMESPACE" deployment/hermes-gateway -- python - <<'PY'
import json
import os
import urllib.request
payload = json.dumps({"session": "core-smoke", "text": "Reply with HERMES_OK."}).encode()
