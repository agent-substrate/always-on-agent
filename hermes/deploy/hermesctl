  local account_id="${VERTEX_SERVICE_ACCOUNT%%@*}"
  local default_email="${account_id}@${PROJECT_ID}.iam.gserviceaccount.com"
  if ! gcloud iam service-accounts describe "$VERTEX_SERVICE_ACCOUNT" \
       --project "$PROJECT_ID" >/dev/null 2>&1; then
    [[ "$VERTEX_SERVICE_ACCOUNT" == "$default_email" ]] || die \
      "VERTEX_SERVICE_ACCOUNT ${VERTEX_SERVICE_ACCOUNT} does not exist"
    say "creating the Vertex model service account"
    gcloud iam service-accounts create "$account_id" --project "$PROJECT_ID" \
      --display-name="Hermes model proxy"
  fi

  say "binding the gateway's Workload Identity to Vertex AI"
  gcloud services enable aiplatform.googleapis.com --project "$VERTEX_PROJECT"
  gcloud iam service-accounts add-iam-policy-binding "$VERTEX_SERVICE_ACCOUNT" \
    --project "$PROJECT_ID" \
    --member="serviceAccount:${PROJECT_ID}.svc.id.goog[${NAMESPACE}/hermes-gateway]" \
    --role="roles/iam.workloadIdentityUser" >/dev/null
  gcloud projects add-iam-policy-binding "$VERTEX_PROJECT" \
    --member="serviceAccount:${VERTEX_SERVICE_ACCOUNT}" \
    --role="roles/aiplatform.user" --condition=None >/dev/null
}

cmd_substrate_install() {
  load_env
  local src="${SUBSTRATE_SRC:-${ROOT}/../substrate}"
  [[ -d "$src" ]] || die "Substrate source not found at ${src}, clone
    https://github.com/agent-substrate/substrate and set SUBSTRATE_SRC"
  # Substrate v1 always installs sdsmint, the egress MITM CA the actor trust
  # bundle derives from, so EGRESS_SDSMINT no longer gates anything. The extproc
  # filter is still an experimental install-time flag.
  local install_args=(
    # Required by v1: where egress fetches credentials from. The bundled
    # Kubernetes Secrets provider.
    --credential-provider='{"name":"k8s.io"}'
    # v1 lets no client reach actors through atenet-router unless its SPIFFE ID
    # is listed: the Hermes gateway, and kubectl-ate's ingress client (used by
    # `kubectl ate proxy actor` in demo/validate.sh).
    --ingress-allowed-spiffe-ids="spiffe://cluster.local/ns/hermes/sa/hermes-gateway,spiffe://cluster.local/ns/ate-system/sa/atenet-client"
  )
  if [[ -n "${EGRESS_EXTPROC_SERVICE:-}" ]]; then
    install_args+=(--experimental-additional-egress-extproc-service "$EGRESS_EXTPROC_SERVICE")
  fi

  # Telemetry before Substrate, deliberately. Substrate's shipped default points
  # every component at GKE's MANAGED collector, in a namespace that only exists
  # where that addon is enabled -- it is not here, and it was not on substrate-poc,
  # which is why every atelet there failed to resolve a collector once a minute and
  # the Aug 5 numbers came off log scraping. Deploying first means the endpoint
  # resolves from the very first export instead of after a restart.
  if [[ "${OTEL_COLLECTOR:-0}" == "1" ]]; then
    say "deploying the OTel collector"
    kubectl apply -f "${ROOT}/k8s/otel-collector.yaml"
    kubectl rollout status deploy/opentelemetry-collector -n otel-system --timeout=180s
    : "${ATE_OTLP_ENDPOINT:=http://opentelemetry-collector.otel-system.svc.cluster.local:4317}"
  fi

  say "installing Agent Substrate from ${src}"
  [[ -n "${EGRESS_EXTPROC_SERVICE:-}" ]] && say "egress extproc: ${EGRESS_EXTPROC_SERVICE}"
  [[ -n "${ATE_OTLP_ENDPOINT:-}" ]] && say "telemetry: ${ATE_OTLP_ENDPOINT}"
  # ATE_OTLP_ENDPOINT has to be passed HERE and not patched in afterwards: the
  # install rewrites the ate-otel-config ConfigMap, so a patch applied before a
  # reinstall is silently reverted. ate-setup reads it, like the other settings
  # below, from the environment when no flag is given.
  ( cd "$src"
    PROJECT_ID="$PROJECT_ID" CLUSTER_NAME="$CLUSTER_NAME" \
    CLUSTER_LOCATION="$CLUSTER_LOCATION" BUCKET_NAME="$BUCKET_NAME" \
    SNAPSHOT_TRANSFER_GSA_NAME="${SNAPSHOT_TRANSFER_GSA_NAME:-ate-snapshot-transfer}" \
    SNAPSHOT_LOCATION="${SNAPSHOT_LOCATION:-gs://${BUCKET_NAME}/${ATESPACE}/}" \
    ATE_IMAGE_REPO="${ATE_IMAGE_REPO:-}" ATE_IMAGE_TAG="${ATE_IMAGE_TAG:-}" \
    ATE_OTLP_ENDPOINT="${ATE_OTLP_ENDPOINT:-}" \
    KO_DOCKER_REPO="${KO_DOCKER_REPO:-${REGISTRY}/ate-images}" KO_DEFAULTPLATFORMS=linux/amd64 \
    NO_DEV_ENV=1 go run ./cmd/ate-setup deploy ate-system "${install_args[@]}" )
  # v1's install requires both: SNAPSHOT_TRANSFER_GSA_NAME is the snapshot
  # transfer service account setup-gcp bootstrap (cluster-up) creates, and
  # SNAPSHOT_LOCATION is the cluster-wide prefix every snapshot goes under, since
  # templates no longer name one. ATE_IMAGE_REPO and ATE_IMAGE_TAG install a
  # release's published images instead of building them, which also avoids the
  # docker build a source install needs for envoy-dataplane.
  configure_atenet_router_budgets
  kubectl get pods -n ate-system
  ok "substrate installed"
}

# ---------------------------------------------------------------------------
# 4. images
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# container image plumbing
#
# This workstation has no Docker daemon, and the acceptance pass runs from it, so
# neither `docker buildx build` nor `docker buildx imagetools inspect` is
# available. Both have daemonless equivalents that are arguably better here:
# Cloud Build for building (the API is already enabled on the project, and it
# builds natively on linux/amd64 rather than emulating it), and crane for reading
# digests (a plain registry client, no daemon, no local pull).
#
# Docker is still preferred when it IS present, so that this keeps working on a
# workstation that has one and so the behaviour on Maya's machine and a
# another developer's does not silently diverge.
# ---------------------------------------------------------------------------

have_docker() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

# The plugin image is linux/amd64 because the nodes are. Two of the three ways it
# gets built are fine with that: an amd64 host compiles natively, and Cloud Build's
# workers are amd64. The third is not. On an arm64 host with Docker, --platform
# linux/amd64 runs the Go COMPILER under emulation and it segfaults -
#
#   math/bits: compile: signal: segmentation fault
#
# - reproducibly, with an error that looks like a broken toolchain rather than a
# broken build strategy. So on that host, cross-compile here (which Go does
# natively and in seconds) and build from Dockerfile.prebuilt instead.
#
egress_plugin_stage_binary() {
  DOCKERFILE=""
  export DOCKERFILE
  have_docker || return 0                      # Cloud Build: amd64 workers already
  [[ "$(uname -m)" == "x86_64" ]] && return 0  # native, nothing to emulate
  local go="${GO:-go}"
  command -v "$go" >/dev/null 2>&1 || die "this is a $(uname -m) host, so the plugin
    has to be cross-compiled before the image is built, and there is no Go toolchain
    on PATH. Install Go, set GO=/path/to/go, or build on an amd64 machine."
  say "cross-compiling the plugin for linux/amd64 on this $(uname -m) host"
  ( cd "${ROOT}/egress-plugin" \
      && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
         "$go" build -trimpath -ldflags="-s -w" -o plugin . ) \
    || die "cross-compile failed; nothing was pushed"
  DOCKERFILE="Dockerfile.prebuilt"
}

# roleRef is immutable, and this is the one thing that makes an UPGRADE of an
# existing cluster behave differently from a fresh install. Change a binding's
# Role and kubectl refuses the whole apply with
#
#   ... is invalid: roleRef: Invalid value: ...: cannot change roleRef
#
# which names neither the namespace nor, in a multi-document file, which binding
# it means. So compare first and say precisely what to delete.
#
# Only bindings that already exist AND disagree are reported: a fresh cluster
# passes through silently, which is what makes it safe to call on every apply.
#
rbac_precheck() {
  local manifest="$1"
  # The caller names the file when it hands us a rendered stream rather than a
  # path, so the message says "hermes-gateway.yaml" and not "/dev/fd/63".
  local label="${2:-${manifest##*/}}"
  local kind name ns want live target
  while IFS=$'\t' read -r kind name want ns; do
    [[ -n "${kind:-}" ]] || continue
    target=("${kind}" "${name}")
    [[ -n "$ns" ]] && target+=(-n "$ns")
    live=$(kubectl get "${target[@]}" -o jsonpath='{.roleRef.kind}/{.roleRef.name}' \
           2>/dev/null) || continue
    [[ -n "$live" && "$live" != "$want" ]] || continue
    die "roleRef is immutable, and this apply changes one.

    ${kind} ${name}${ns:+ in namespace ${ns}}
      on the cluster: ${live}
      in ${label}: ${want}

  kubectl will reject the apply with \"cannot change roleRef\" and will not tell
  you which binding or which namespace it meant. Delete the old one and re-run -
  it is recreated by this same command:

    kubectl delete $(printf %s "${kind}" | tr 'A-Z' 'a-z') ${name}${ns:+ -n ${ns}}"
  done < <(rbac_bindings "$manifest")
}

# rbac_bindings MANIFEST -> one TSV line per binding: kind, name, namespace,
# roleRef as Kind/Name. Namespace is empty for a ClusterRoleBinding.
#
# The YAML is normalised through kubectl rather than parsed here: it is a
# multi-document file, and a system python3 has no yaml module often enough that
# depending on one would make the pre-check silently skip itself.
#
# It must be `create --dry-run=client` and NOT `apply --dry-run=client`. Apply
# does a three-way merge against the live object, and because roleRef is
# immutable the merge KEEPS THE LIVE VALUE - so the manifest's new roleRef never
# appears in the output and the pre-check passes on exactly the manifest it
# exists to catch. Measured, after writing it the other way first.
#
# create -o json emits one JSON document per resource, concatenated rather than
# wrapped in a List, hence the raw_decode loop.
rbac_bindings() {
  kubectl create -f "$1" --dry-run=client -o json 2>/dev/null | python3 -c '
import json, sys

text = sys.stdin.read()
decoder, i, docs = json.JSONDecoder(), 0, []
while i < len(text):
    while i < len(text) and text[i].isspace():
        i += 1
    if i >= len(text):
        break
    try:
        doc, i = decoder.raw_decode(text, i)
    except ValueError:
        break
    docs.append(doc)

for doc in docs:
    for o in doc.get("items", [doc]):
        if o.get("kind") not in ("RoleBinding", "ClusterRoleBinding"):
            continue
        m, r = o.get("metadata", {}), o.get("roleRef", {})
        # Namespace LAST, and that ordering is load-bearing. `read` with a
        # whitespace IFS (tab is whitespace) collapses consecutive delimiters,
        # so an empty namespace in the middle shifts every later field left and
        # the roleRef lands in `ns`. A trailing empty field is harmless.
        print("\t".join([o["kind"], m.get("name", ""),
                         "%s/%s" % (r.get("kind", ""), r.get("name", "")),
                         m.get("namespace", "")]))
' 2>/dev/null || true
}

# image_digest REF -> sha256:... on stdout, non-zero if the tag does not exist.
image_digest() {
  if have_docker; then
    docker buildx imagetools inspect "$1" --format '{{.Manifest.Digest}}' 2>/dev/null
  elif command -v crane >/dev/null 2>&1; then
    crane digest "$1" 2>/dev/null
  else
    die "need either a running Docker daemon or crane on PATH to resolve image digests
    (go install github.com/google/go-containerregistry/cmd/crane@latest)"
  fi
}

# image_build CONTEXT_DIR TAG [TAG...] -- builds linux/amd64 and pushes every tag.
# Set DOCKERFILE to a path (relative to CONTEXT_DIR) to build something other
# than CONTEXT_DIR/Dockerfile.
image_build() {
  local ctx="$1"; shift
  local tags=("$@") t
  local base_arg="${CORE_IMAGE_ARG:-}"
  if have_docker; then
    local args=(--platform linux/amd64 --push)
    [[ -n "${DOCKERFILE:-}" ]] && args+=(-f "${ctx}/${DOCKERFILE}")
    [[ -n "$base_arg" ]] && args+=(--build-arg "$base_arg")
    for t in "${tags[@]}"; do args+=(-t "$t"); done
    docker buildx inspect hermes-builder >/dev/null 2>&1 \
      || docker buildx create --name hermes-builder --use >/dev/null
    docker buildx use hermes-builder
    docker buildx build "${args[@]}" "$ctx"
    return
  fi
  command -v gcloud >/dev/null 2>&1 \
    || die "no Docker daemon and no gcloud: cannot build ${ctx}"

  # Cloud Build workers are linux/amd64, which is what the nodes are, so there
  # is no emulation and no --platform to get wrong.
  #
  # This goes through a generated config rather than `--tag`, for two reasons.
  # `--tag` takes exactly one tag, and the actor needs its content tag and
  # :latest to name the SAME image: two builds of one Dockerfile do not produce
  # the same digest, so tagging twice would quietly break the skip-if-unchanged
  # check below. And `--tag` cannot point at a Dockerfile outside the context
  # root, which the console needs.
  local cfg; cfg=$(mktemp -d)/cloudbuild.yaml
  { echo "steps:"
    echo "- name: gcr.io/cloud-builders/docker"
    echo "  args:"
    echo "  - build"
    echo "  - --file=${DOCKERFILE:-Dockerfile}"
    if [[ -n "$base_arg" ]]; then echo "  - --build-arg=${base_arg}"; fi
    for t in "${tags[@]}"; do echo "  - --tag=${t}"; done
    echo "  - ."
    echo "images:"
    for t in "${tags[@]}"; do echo "- ${t}"; done
  } > "$cfg"
  # --async, then poll. Streaming logs needs project Viewer/Owner, which this
  # account does not have, and without it `gcloud builds submit` exits non-zero
  # AFTER the build has been accepted -- so a synchronous submit reports failure
  # on builds that go on to succeed. Polling reports the build's real status.
  local id
  id=$(gcloud builds submit "$ctx" --project "$PROJECT_ID" --config "$cfg" \
       --async --format='value(id)' --quiet) \
    || { rm -rf "$(dirname "$cfg")"; die "could not submit the build for ${ctx}"; }
  rm -rf "$(dirname "$cfg")"
  say "cloud build ${id}"
  local status=""
  while :; do
    status=$(gcloud builds describe "$id" --project "$PROJECT_ID" \
             --format='value(status)' 2>/dev/null)
    case "$status" in
      SUCCESS) break ;;
      FAILURE|TIMEOUT|CANCELLED|EXPIRED)
        die "build ${id} ended ${status}: gcloud builds log ${id} --project ${PROJECT_ID}" ;;
      *) sleep 10 ;;
    esac
  done
}

cmd_build() {
  load_env
  say "staging kubectl-ate into the gateway build context"
  # The gateway shells out to kubectl-ate for actor lifecycle, so the binary must
  # be IN the build context and must be linux/amd64, a macOS/arm64 copy builds an
  # image that fails at runtime with exec format error, which is a confusing way to
  # find out. Build it from the Substrate source rather than copying the host one.
  local src="${SUBSTRATE_SRC:-${ROOT}/../substrate}"
  # Which Substrate the staged binary was built from, recorded beside it.
  #
  # "already staged and linux/amd64" used to be the whole test, and it is not
  # enough. A binary left over from a main-based cluster is x86-64 and passes,
  # so pointing SUBSTRATE_SRC at release-0.1 and rebuilding silently ships the
  # OLD client: same file, never rebuilt, no message. The wire-format check below
  # is what would normally catch that, and it cannot run on a fresh cluster
  # because there is no gateway pod to run it in yet. Which is precisely when
  # SUBSTRATE_SRC has just been repointed. So compare the source too.
  local ate_src_id="" ate_stamp="${ROOT}/gateway/.kubectl-ate-src"
  if [[ -d "$src" ]] && command -v git >/dev/null 2>&1; then
    ate_src_id="$( cd "$src" && git rev-parse HEAD 2>/dev/null || true )"
  fi
  if [[ -x "${ROOT}/gateway/kubectl-ate" ]] \
     && file "${ROOT}/gateway/kubectl-ate" 2>/dev/null | grep -q "x86-64" \
     && [[ -n "$ate_src_id" ]] && [[ -f "$ate_stamp" ]] \
     && [[ "$(cat "$ate_stamp")" == "$ate_src_id" ]]; then
    ok "kubectl-ate already staged from ${ate_src_id:0:8}"
  elif [[ -d "$src" ]] && command -v go >/dev/null 2>&1; then
    [[ -f "$ate_stamp" && "$(cat "$ate_stamp")" != "$ate_src_id" ]] \
      && say "staged kubectl-ate came from $(cut -c1-8 "$ate_stamp"), rebuilding"
    ( cd "$src" && GOOS=linux GOARCH=amd64 \
        go build -o "${ROOT}/gateway/kubectl-ate" ./cmd/kubectl-ate )
    printf '%s\n' "$ate_src_id" > "$ate_stamp"
    ok "built kubectl-ate from ${src} (${ate_src_id:0:8})"
  else
    die "cannot stage kubectl-ate: need Go + Substrate source at ${src}
    (or drop a linux/amd64 binary at gateway/kubectl-ate yourself)"
  fi

  # The staged client MUST speak the same protobuf as the installed
  # ate-api-server. Building it from a Substrate checkout at HEAD, when the
  # cluster was installed from an older commit, produces a binary that fails
  # every call with "cannot parse invalid wire-format data", and because the
  # gateway identifies callers by asking which actor is RUNNING, that silently
  # takes down every agent's Google access while the gateway looks healthy.
  #
  # So: verify against the live cluster before shipping it, if the cluster is up.
  # Pin SUBSTRATE_REF in env.sh to the commit the cluster was installed from, or
  # keep a known-good gateway/kubectl-ate in place and this check will pass.
  if kubectl get ns "$NAMESPACE" >/dev/null 2>&1 \
     && kubectl get deploy -n "$NAMESPACE" hermes-gateway >/dev/null 2>&1; then
    local pod
    pod=$(kubectl get pod -n "$NAMESPACE" -l app=hermes-gateway \
          -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
    if [[ -n "$pod" ]]; then
      kubectl cp "${ROOT}/gateway/kubectl-ate" "${NAMESPACE}/${pod}:/tmp/ate-check" \
        >/dev/null 2>&1
      kubectl exec -n "$NAMESPACE" "$pod" -- chmod +x /tmp/ate-check >/dev/null 2>&1
      if kubectl exec -n "$NAMESPACE" "$pod" -- /tmp/ate-check get actor \
           -a "$ATESPACE" >/dev/null 2>&1; then
        ok "staged kubectl-ate talks to the installed ate-api-server"
      else
        warn "the staged kubectl-ate CANNOT talk to the installed ate-api-server."
        warn "Shipping it would break caller identification and every Google call."
        warn "Rebuild it from the Substrate commit the cluster was installed from,"
        warn "or restore a known-good binary at gateway/kubectl-ate."
        die "refusing to build a gateway with an incompatible ate client"
      fi
    fi
  fi

  # Built through image_build, which uses the local Docker daemon when there is
  # one and Cloud Build when there is not. Either way the result is linux/amd64,
  # because the nodes are.
  say "building gateway image (linux/amd64)"
  DOCKERFILE=Dockerfile CORE_IMAGE_ARG= image_build "${ROOT}/gateway" "${REGISTRY}/gateway:latest"

  # The actor image is CONTENT-TAGGED, and that is load-bearing rather than
  # tidy. Buildx does not produce byte-identical images from identical sources,
  # so :latest gets a new digest on every build. An ActorTemplate is immutable
  # and pins that digest, so a changed digest means recreating the template ,
  # which deletes every actor in the fleet. Tagging by a hash of actor/ means an
  # unchanged actor rebuilds to the same tag, the digest holds, and a routine
  # gateway deploy stops evicting everybody's agent.
  #
  # Hash RELATIVE paths, from inside ROOT, with a fixed collation. shasum prints
  # the filename beside each digest, so hashing "${ROOT}/actor/..." folds the
  # checkout's absolute path into the tag: the same source in a different
  # directory, or on a another developer's machine, hashes differently, rebuilds, gets a
  # new digest, and forces exactly the template recreation -- and fleet-wide
  # eviction -- this scheme exists to avoid. Locale affects sort order and so
  # affects the digest too.
  local actor_tag
  actor_tag="src-$( cd "${ROOT}" \
    && find ./actor -type f -not -name '*.pyc' -print0 \
    | LC_ALL=C sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -c1-16 )"
  if image_digest "${REGISTRY}/actor:${actor_tag}" >/dev/null; then
    ok "actor image unchanged (${actor_tag}), skipping build"
  else
    say "building actor image (core Hermes, linux/amd64)"
    DOCKERFILE=Dockerfile CORE_IMAGE_ARG= image_build "${ROOT}/actor" \
      "${REGISTRY}/actor:${actor_tag}" "${REGISTRY}/actor:latest"
  fi
  echo "$actor_tag" > "${ROOT}/deploy/.actor-tag"

  ok "images pushed to ${REGISTRY}"
}

# ---------------------------------------------------------------------------
# 5. deploy
# ---------------------------------------------------------------------------

cmd_deploy() {
  load_env
  say "namespace + rbac"
  rbac_precheck "${ROOT}/k8s/hermes-namespace-rbac.yaml"
  kubectl apply -f "${ROOT}/k8s/hermes-namespace-rbac.yaml"
  configure_vertex_proxy_identity

  say "secrets"
  local model_key=""
  [[ -f "${MODEL_API_KEY_FILE:-}" ]] && model_key="$(cat "$MODEL_API_KEY_FILE")"

  # API_SERVER_KEY must SURVIVE a redeploy. The actor authenticates the gateway
  # with it, and the value it checks against was captured in its golden snapshot
  #, so minting a fresh key on every deploy silently locks the gateway out of
  # every already-warmed actor, which surfaces much later as
  #   {"error": {"message": "Invalid gateway API key (API_SERVER_KEY)"}}
  # on a turn that has nothing else wrong with it. Reuse whatever the cluster
  # already has; generate only on the first deploy.
  local api_key
  api_key=$(kubectl get secret hermes-secrets -n "$NAMESPACE" \
    -o jsonpath='{.data.API_SERVER_KEY}' 2>/dev/null | base64 -d 2>/dev/null || true)
  if [[ -z "$api_key" ]]; then
    api_key="$(openssl rand -hex 24)"
    say "minted a new API_SERVER_KEY (first deploy)"
  else
    ok "reusing the existing API_SERVER_KEY (warmed actors stay valid)"
  fi
  local ingress_key
  ingress_key=$(kubectl get secret hermes-secrets -n "$NAMESPACE" \
    -o jsonpath='{.data.GATEWAY_INGRESS_KEY}' 2>/dev/null | base64 -d 2>/dev/null || true)
  if [[ -z "$ingress_key" || "$ingress_key" == "$api_key" ]]; then
    ingress_key="$(openssl rand -hex 32)"
  fi
  kubectl create secret generic hermes-secrets -n "$NAMESPACE" \
    --from-literal=MODEL_API_KEY="${model_key}" \
    --from-literal=API_SERVER_KEY="${api_key}" \
    --from-literal=GATEWAY_INGRESS_KEY="${ingress_key}" \
    --dry-run=client -o yaml | kubectl apply -f -

  say "worker pool + actor template + gateway"
  # ateom is the coordinator that runs INSIDE each worker pod and drives the
  # sandbox. Substrate's own manifests reference it as a ko:// path resolved at
  # deploy time, which means install-ate.sh never built it, it is not a running
  # workload we can read an image tag from. So build it here, the same way their
  # demos do, and pin the digest ko returns.
  local ateom_image="${ATEOM_IMAGE:-}"
  if [[ -z "$ateom_image" && -n "${ATE_IMAGE_REPO:-}" && -n "${ATE_IMAGE_TAG:-}" ]]; then
    # The release's own worker image, pinned to the digest its tag names now.
    local ref="${ATE_IMAGE_REPO}/ateworker-gvisor:${ATE_IMAGE_TAG}" dg
    dg=$(image_digest "$ref") || die "could not resolve ${ref}"
    ateom_image="${ATE_IMAGE_REPO}/ateworker-gvisor@${dg}"
  fi
  if [[ -z "$ateom_image" ]]; then
    local src="${SUBSTRATE_SRC:-${ROOT}/../substrate}"
    command -v ko >/dev/null 2>&1 || die "ko is required to build ateworker-gvisor"
    say "building ateworker-gvisor (Substrate's gVisor worker)"
    ateom_image=$( cd "$src" && KO_DOCKER_REPO="${REGISTRY}/ate-images" \
      KO_DEFAULTPLATFORMS=linux/amd64 ko build --bare ./cmd/ateworker-gvisor 2>/dev/null | tail -1 )
  fi
  [[ -n "$ateom_image" ]] || die "could not build or resolve the ateom image"
  ok "ateom image: ${ateom_image##*/}"

  # Substrate REQUIRES digest-pinned images in an ActorTemplate: a tag can move,
  # and a moved image invalidates every snapshot taken from it. Resolve tags to
  # digests here rather than making the operator paste them by hand.
  say "pinning images to digests"
  local actor_pinned gateway_pinned
  local variant=""
  variant="${IMAGE_VARIANT:-}"
  local actor_ref="${REGISTRY}/actor${variant}:latest"
  if [[ -f "${ROOT}/deploy/.actor-tag${variant}" ]]; then
    actor_ref="${REGISTRY}/actor${variant}:$(cat "${ROOT}/deploy/.actor-tag${variant}")"
  fi
  actor_pinned="${REGISTRY}/actor${variant}@$(image_digest "$actor_ref")"
  # No pause image pinned here any more: pauseImage moved off ActorTemplate and
  # onto SandboxConfig upstream, so the installer owns it. Resolving it here cost
  # a registry round-trip on every deploy to fill a field that no longer exists.
  gateway_pinned="${REGISTRY}/gateway${variant}@$(image_digest "${REGISTRY}/gateway${variant}:latest")"
  ok "actor   ${actor_pinned##*@}"
  ok "gateway ${gateway_pinned##*@}"

  # Actors are NOT Kubernetes resources, they live in Substrate's own API and
  # are reached through kubectl-ate, which runs inside the gateway pod. This
  # matters more than it looks: `kubectl get actor` does not fail loudly, it
  # reports no such resource type and yields nothing, so a cleanup written
  # against kubectl silently deletes nothing at all. That left actors orphaned
  # against a regenerated golden snapshot, stuck in STATUS_RESUMING forever,
  # answering every turn with a 504.
  ate() { kubectl exec -n "$NAMESPACE" deployment/hermes-gateway -- kubectl-ate "$@"; }

  # A RUNNING actor is not deletable ("is not in a deletable status"), so each
  # one is suspended first and given a moment to get there.
  delete_all_actors() {
    local names
    names=$(ate get actor -a "$ATESPACE" -o json 2>/dev/null | ate_actor_states || true)
    [[ -n "$names" ]] || return 0
    say "removing $(wc -l <<<"$names" | tr -d " ") actor(s) built from the old template"
    while read -r name status; do
      [[ -n "$name" ]] || continue
      [[ "$status" == "ACTOR_STATE_SUSPENDED" ]] || ate suspend actor "$name" -a "$ATESPACE" >/dev/null 2>&1 || true
    done <<<"$names"
    local tries=0
    while read -r name _; do
      [[ -n "$name" ]] || continue
      until ate delete actor "$name" -a "$ATESPACE" >/dev/null 2>&1; do
        tries=$((tries + 1))
        [[ $tries -lt 30 ]] || { warn "could not delete actor ${name}, delete it by hand"; break; }
        sleep 2
      done
    done <<<"$names"
    ok "actors removed (they cold-start from the new snapshot on the next turn)"
  }

  # Templates are IMMUTABLE and, since the CRD was deleted on 2026-09-02, they
  # are not Kubernetes objects either. There is no `kubectl apply`, no update RPC
  # and no dry run, so a rebuilt actor image can never reach the cluster by
  # re-applying: the deploy looks like it worked and silently keeps serving the
  # old image. So: compare, and if the template really changed, replace it.
  #
  # The comparison used to be `kubectl apply --dry-run=server` asking the API
  # server whether anything immutable had moved. Nothing replaces that, so it is
  # done locally in deploy/template_diff.py.
  #
  # Recreating a template invalidates its golden snapshot, so every actor made
  # from it must go first. That is a real cost and it is why this is not
  # unconditional: deleting an actor also deletes the identity that owns its
  # DurableDir, so this path is destructive for a populated fleet. A production
  # image migration needs an explicit state-transfer procedure; do not describe
  # template replacement as preserving actor state.
  # sdsmint is an INSTALL-TIME flag and this template hard-depends on it: the
  # systemInfo volume names the egress-mitm trust bundle, and a bundle that does
  # not resolve does not degrade the actor, it stops it from starting. So an
  # existing cluster cannot take this template by applying it - it needs a
  # reinstall, and the failure otherwise is every actor in the fleet.
  #
  # Checked against the CLUSTER and not against EGRESS_SDSMINT in env.sh: the
  # env file records what we meant to install, and this needs what is there.
  #
  # Reject incompatible templates before applying them.
  actortemplate_trustbundle_precheck() {
    local desired="$1" bundle
    # `|| true` matters: a template with no trustBundle at all is the pre-sdsmint
    # one, which is legitimate. Without it grep's empty exit status trips
    # errexit and this refuses the deploy it is supposed to wave through.
    bundle=$(grep -A3 'trustBundle:' <<<"$desired" \
             | sed -n 's/^[[:space:]]*name:[[:space:]]*//p' | head -1 || true)
    [[ -n "$bundle" ]] || return 0
    if kubectl get clustertrustbundles -o name 2>/dev/null | grep -q "/${bundle}:"; then
      return 0
    fi
    die "the actor template needs the '${bundle}' trust bundle and this cluster has no
    ClusterTrustBundle for it. Substrate v1 creates that bundle at install time (sdsmint
    is always installed), so its absence means the install did not complete or this
    cluster runs an older release. It needs a (re)install rather than another apply.

  Applying anyway would not degrade anything gracefully - the volume would not resolve
  and EVERY actor would fail to start, with the images and the WorkerPool all healthy.

  Present bundles:
$(kubectl get clustertrustbundles -o name 2>/dev/null | sed 's|^|    |' || echo '    (none)')"
  }

  # `ate` runs in the gateway pod without stdin. Creating a template needs the
  # manifest piped in, so it gets its own wrapper rather than a -i on every call.
  ate_stdin() { kubectl exec -i -n "$NAMESPACE" deployment/hermes-gateway -- kubectl-ate "$@"; }

  # There is no `kubectl wait` for a template: no CRD, so no conditions to wait
  # on. Readiness is goldenSnapshotStatus.goldenSnapshot becoming set.
  #
  # This polls rather than sleeps, and it reads errorMessage on every pass. That
  # field is the whole reason this is not just a sleep: a golden that cannot be
  # warmed sits at an empty status looking exactly like one that has not started
  # yet, and the real cause only appears in the ate-api-server log. Surfacing it
  # here turns a ten-minute silent timeout into an immediate answer.
  wait_golden() {
    local deadline=$((SECONDS + 600)) out state
    say "waiting for the golden snapshot"
    while [[ $SECONDS -lt $deadline ]]; do
      out=$(ate get actor-template hermes -a "$ATESPACE" -o json 2>/dev/null || true)
      state=$(printf '%s' "$out" | "$PYTHON" -c 'import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
ts = d.get("actorTemplates") or ([d] if d.get("metadata") else [])
if not ts:
    sys.exit(0)
g = (ts[0].get("status") or {}).get("goldenSnapshotStatus") or {}
err = g.get("errorMessage")
if err:
    print("error", err)
elif (g.get("goldenSnapshot") or {}).get("snapshotUri"):
    print("ready", g["goldenSnapshot"]["snapshotUri"])
elif (g.get("goldenTag") or {}).get("name"):
    # Substrate v1 publishes the golden snapshot as a tag.
    print("ready", "tag " + g["goldenTag"]["name"])
else:
    print("pending")' || true)
      case "$state" in
        ready\ *) ok "golden snapshot ready (${state#ready })"; return 0 ;;
        error\ *) warn "golden snapshot failed: ${state#error }"; return 1 ;;
      esac
      sleep 5
    done
    warn "golden snapshot not ready after 600s. Check the ate-api-server log:"
    warn "  kubectl logs -n ate-system deployment/ate-api-server | grep -i golden"
    warn "A worker with no reported capacity is permanently unschedulable while"
    warn "still displaying as FREE, and that is what this looks like."
    return 1
  }

  apply_actortemplate() {
    local desired="$1"
    actortemplate_trustbundle_precheck "$desired"

    local manifest live rc=0
    manifest=$(mktemp) && live=$(mktemp)
    printf '%s\n' "$desired" >"$manifest"
    ate get actor-template hermes -a "$ATESPACE" -o json >"$live" 2>/dev/null || true

    "$PYTHON" "${ROOT}/deploy/template_diff.py" "$manifest" "$live" || rc=$?
    case $rc in
      0)
        rm -f "$manifest" "$live"
        ok "actor template unchanged"
        return 0
        ;;
      2)
        say "creating the actor template"
        ate_stdin create actor-template -f - <"$manifest"
        rm -f "$manifest" "$live"
        wait_golden || true
        ok "actor template created"
        return 0
        ;;
    esac

    warn "the actor template changed (new actor image), it is immutable, so it"
    warn "must be recreated. Actors built from it will be deleted and will cold-"
    warn "start empty on their next turn; deleting them also deletes their durable state."
    delete_all_actors
    # Deleting the template also deletes its golden actor and golden snapshot,
    # which is why the actors have to go first.
    ate delete actor-template hermes -a "$ATESPACE" || true
    ate_stdin create actor-template -f - <"$manifest"
    rm -f "$manifest" "$live"
    wait_golden || true
    ok "actor template recreated"
  }

  # A worker holds ONE awake actor, so this caps concurrency, not how many
  # agents exist. The manifest ships with 6; a pilot wants 2.
  #
  # This MUST happen before the ActorTemplate is applied. Warming a golden
  # snapshot resumes a golden actor onto some worker; scaling the pool down
  # afterwards can kill that exact pod, and the template then sits in
  # ResumeGoldenActor forever with no error anywhere, every later turn just
  # times out. Scale first, apply second, and the warm-up lands on a stable pool.
  scale_workers() {
    kubectl scale workerpool/hermes -n "$NAMESPACE" --replicas "$WORKER_REPLICAS" 2>/dev/null \
      || kubectl patch workerpool hermes -n "$NAMESPACE" --type=merge \
           -p "{\"spec\":{\"replicas\":${WORKER_REPLICAS}}}" 2>/dev/null \
      || warn "could not set worker replicas to ${WORKER_REPLICAS}, check the WorkerPool"
  }

  # What the actor gets for MODEL_API_KEY. Empty is the intended state: with
  # egress credential injection the actor calls the model with no credential and
  # the plugin attaches one on the way out. ACTOR_MODEL_KEY_INLINE=1 puts the
  # real key in the ActorTemplate instead, for a cluster where egress injection
  # is not live yet. Anyone who can read actortemplates can then read the key, so
  # it is a way to stay unblocked rather than somewhere to stop.
  #
  # A missing key skips the template rather than killing the deploy. The template
  # is immutable and the key is baked into it, so creating one with an empty key
  # is not a thing you correct later: it means deleting the template, which takes
  # the golden actor and the golden snapshot with it, and warming again. Dying
  # here instead would leave the worker pool and the gateway unbuilt too, and
  # those are exactly what you want up and settled while you go and find the key.
  local actor_model_key="" skip_template=0 vertex_sa_annotation=""
  if [[ "$VERTEX_PROXY_ENABLED" == "1" ]]; then
    # This is the same internal key the actor already needs for inbound turns,
    # not a Google credential. The gateway exchanges its own Workload Identity
    # for the short-lived Vertex token.
    actor_model_key="$api_key"
    vertex_sa_annotation="$VERTEX_SERVICE_ACCOUNT"
  elif [[ "${ACTOR_MODEL_KEY_INLINE:-0}" == "1" ]]; then
    actor_model_key="${model_key}"
    if [[ -z "$actor_model_key" ]]; then
      skip_template=1
      warn "no model key at ${MODEL_API_KEY_FILE:-unset} and ACTOR_MODEL_KEY_INLINE=1."
      warn "The worker pool and the gateway go up; the ActorTemplate does NOT."
    else
      warn "ACTOR_MODEL_KEY_INLINE=1: the model key is stored in the ActorTemplate"
      warn "in plaintext. Clear it once egress injection is live."
    fi
  fi

  # sed replacement text is not literal: & and the delimiter both mean something,
  # credentials routinely contain both, and the failure is silent corruption
  # rather than an error. Escape before substituting.
  sed_escape() { printf '%s' "$1" | sed -e 's/[|&\\]/\\&/g'; }
  local actor_model_key_esc api_key_esc
  actor_model_key_esc="$(sed_escape "$actor_model_key")"
  api_key_esc="$(sed_escape "$api_key")"

  render() {
    sed < "$1" -e "s|REPLACE_WITH_REGISTRY|${REGISTRY}|g" \
        -e "s|REPLACE_WITH_ACTOR_MODEL_KEY|${actor_model_key_esc}|g" \
        -e "s|REPLACE_WITH_API_SERVER_KEY|${api_key_esc}|g" \
        -e "s|REPLACE_WITH_ACTOR_IMAGE|${actor_pinned}|g" \
        -e "s|REPLACE_WITH_GATEWAY_IMAGE|${gateway_pinned}|g" \
        -e "s|REPLACE_WITH_ATEOM_IMAGE|${ateom_image}|g" \
        -e "s|REPLACE_WITH_SNAPSHOT_PREFIX|gs://${BUCKET_NAME}/${ATESPACE}|g" \
        -e "s|REPLACE_WITH_BUCKET|${BUCKET_NAME}|g" \
        -e "s|REPLACE_WITH_ATESPACE|${ATESPACE}|g" \
        -e "s|REPLACE_WITH_MODEL_PROVIDER|${MODEL_PROVIDER:-gemini}|g" \
        -e "s|REPLACE_WITH_MODEL_BASE_URL|${MODEL_BASE_URL:-https://generativelanguage.googleapis.com}|g" \
        -e "s|REPLACE_WITH_MODEL_PROXY_BACKEND|${MODEL_PROXY_BACKEND:-vertex}|g" \
        -e "s|REPLACE_WITH_MODEL|${MODEL_DEFAULT:-gemini-3.1-pro-preview}|g" \
        -e "s|REPLACE_WITH_PROJECT|${VERTEX_PROJECT}|g" \
        -e "s|REPLACE_WITH_VERTEX_SERVICE_ACCOUNT|${vertex_sa_annotation}|g" \
        -e "s|REPLACE_WITH_VERTEX_PROXY_ENABLED|${VERTEX_PROXY_ENABLED:-0}|g" \
        -e "s|REPLACE_WITH_VERTEX_LOCATION|${VERTEX_LOCATION:-global}|g" \
        -e "s|REPLACE_WITH_VERTEX_MODEL|${VERTEX_MODEL:-google/gemini-3.1-pro-preview}|g" \
        -e "s|REPLACE_WITH_OPENAI_MODEL|${OPENAI_MODEL:-gpt-5.6-luna}|g" \

  }
  apply_rendered() {
    local out; out=$(render "${ROOT}/k8s/$1")
    # Ignore comments: these files document their own placeholders in a header
    # comment ("the REPLACE_WITH_* values are substituted by ..."), and matching
    # that is a false positive that blocks a perfectly good manifest. Require at
    # least one letter after the underscore so the bare prefix does not match.
    local leftover
    leftover=$(grep -v '^[[:space:]]*#' <<<"$out" | grep -o "REPLACE_WITH_[A-Z][A-Z_]*" | sort -u || true)
    if [[ -n "$leftover" ]]; then
      warn "$1 still has unsubstituted placeholders:"
      sed 's/^/      /' <<<"$leftover"
      die "refusing to apply a half-rendered manifest"
    fi
    if [[ "$1" == hermes-actortemplate.yaml ]]; then
      apply_actortemplate "$out"
    else
      rbac_precheck <(printf '%s\n' "$out") "$1"
      kubectl apply -f - <<<"$out"
    fi
  }

  # The worker pool is tainted ate.dev/sandboxClass=gvisor:NoSchedule to keep the
  # Substrate control plane off the nodes being measured. That is only safe while
  # atelet tolerates it: an atelet-less worker node fails every restore at
  # CallAteletRestore, and it fails there silently. So check the live DaemonSet
  # rather than trusting the comment. The name is version-suffixed (atelet-<sha>),
  # so match on the ate-system DaemonSet whose name starts with atelet.
  local atelet_tol
  atelet_tol=$(kubectl get ds -n ate-system -o json 2>/dev/null | python3 -c '
import json, sys
for i in json.load(sys.stdin).get("items", []):
    if not i["metadata"]["name"].startswith("atelet"):
        continue
    for t in i["spec"]["template"]["spec"].get("tolerations") or []:
        if t.get("key") == "ate.dev/sandboxClass":
            print("yes"); break
' 2>/dev/null || true)
  if kubectl get nodes -l substrate.ate.dev/worker=true \
       -o jsonpath='{.items[*].spec.taints[*].key}' 2>/dev/null \
       | grep -q "ate.dev/sandboxClass"; then
    if [[ "$atelet_tol" == "yes" ]]; then
      ok "worker pool is tainted and atelet tolerates it"
    else
      warn "the worker pool is tainted ate.dev/sandboxClass but the atelet DaemonSet"
      warn "does NOT tolerate it. Those nodes will get no atelet, and every restore"
      warn "onto them fails at CallAteletRestore with nothing in the actor's status."
      warn "Remove the taint before going further:"
      warn "  gcloud container node-pools update substrate-workers --node-taints=\"\" \\"
      warn "    --cluster ${CLUSTER_NAME} --zone ${CLUSTER_LOCATION}"
    fi
  fi

  apply_rendered hermes-workerpool.yaml
  scale_workers
  # Gateway first: the template is created by kubectl-ate running inside the
  # gateway pod, so on a fresh install there is nothing to exec into until the
  # gateway is up. It serves no turns before a template exists.
  apply_rendered hermes-gateway.yaml
  kubectl rollout status deployment/hermes-gateway -n "$NAMESPACE" --timeout=180s || true
  if [[ "$skip_template" != 1 ]]; then
    apply_rendered hermes-actortemplate.yaml
  fi
  if [[ "$skip_template" == 1 ]]; then
    warn "deployed WITHOUT an ActorTemplate. No actor can be created and no golden"
    warn "snapshot exists, so nothing will answer a turn yet. Put the key at"
    warn "${MODEL_API_KEY_FILE:-unset} and run this again."
    return 1
  fi
  ok "deployed"
}

