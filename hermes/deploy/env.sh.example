# Copy to deploy/env.sh and fill in. deploy/env.sh is gitignored: it names a real
# project.

export PROJECT_ID=your-gcp-project

export CLUSTER_NAME=hermes-agent
export CLUSTER_LOCATION=us-central1-a
export MACHINE_TYPE=e2-standard-4             # control/gateway nodes

# Workers run the gVisor sandboxes. The CPU platform must be FIXED: c2, c2d or
# c4, never e2. Recycling an actor across CPU platforms corrupts every snapshot
# taken from it, and the failure appears much later as unexplained restore
# errors. c2d was preferred until it hit GCE stockouts in us-central1-a.
export WORKER_MACHINE_TYPE=c2-standard-4
export WORKER_REPLICAS=2                      # a worker holds ONE awake actor:
                                              # this caps concurrency, not fleet size

export BUCKET_NAME=hermes-snapshots-${PROJECT_ID}
export REGISTRY=us-central1-docker.pkg.dev/${PROJECT_ID}/hermes
export ATESPACE=hermes
export NAMESPACE=hermes

# Hermes does NOT infer the provider from the model name; set it explicitly.
# Gemini here, matching demo/env.sh.example and demo/fleet/fleet.example.json.
# Change the host and change EGRESS_ALLOW below with it.
export MODEL_DEFAULT=gemini-3.1-pro-preview
export MODEL_PROVIDER=gemini
export MODEL_BASE_URL=https://generativelanguage.googleapis.com

# Optional: route model calls through the in-cluster gateway and authenticate to
# Vertex AI with GKE Workload Identity. This keeps Google credentials out of the
# actor and its snapshots. hermesctl creates and binds the default service
# account. The actor's provider/base URL are changed automatically when enabled.
# export VERTEX_PROXY_ENABLED=1
# export VERTEX_PROJECT=${PROJECT_ID}
# export VERTEX_SERVICE_ACCOUNT=hermes-model@${PROJECT_ID}.iam.gserviceaccount.com
# export VERTEX_MODEL=google/gemini-3.1-pro-preview
# export OPENAI_MODEL=gpt-5.6-luna

# Substrate's release defaults are shorter than a data-backed Hermes wake and a
# real tool/model turn. hermesctl applies these to atenet-router after install.
export ATENET_PARKED_REQUEST_BUDGET=30s
export ATENET_ROUTE_TIMEOUT=5m
export ATENET_DRAIN_TIMEOUT=5m40s
export ATENET_TERMINATION_GRACE_SECONDS=390


# Tunneled egress, off by default because that is what the cluster runs today.
# 0: actors get direct network access, nothing inspects or restricts it.
# 1: actor egress is tunneled through Substrate's egress gateway, which is what
#    makes per-actor destination policy possible. The gateway alone authenticates
#    the actor certificate and allows every destination.
# On Substrate v1 actor egress is always tunneled through the egress gateway and
# denied until the actor has an egress policy; the gateway creates an allow-all
# policy for each agent (gateway/actor_provisioner.py). This switch only matters
# for releases before v1, whose api server needs --default-egress-gateway-address.
# Applied by `hermesctl egress-on`, undone by `hermesctl egress-off`.
export HERMES_EGRESS=0

# Our destination policy plugin, on top of the gateway. Needs HERMES_EGRESS=1.
# This is the part that can block traffic, so it is its own switch.
export HERMES_EGRESS_PLUGIN=0

# What actors may reach when the plugin is on, space separated. Addresses, not
# hostnames: on a CONNECT the authority is the address the actor already
# resolved, so a hostname entry matches nothing. Empty means everything is
# denied. See egress-plugin/README.md.
export EGRESS_ALLOW=""

# Checkout of github.com/agent-substrate/substrate. cluster-up delegates to its
# own setup-gcp bootstrap rather than hand-rolled gcloud, because that tool sets
# up things whose absence fails much later: the v1beta1 certificates APIs that
# podcertcontroller blocks on forever, Workload Identity, and the IAM that lets
# atelet write snapshots at all.
export SUBSTRATE_SRC=../substrate
# Install a Substrate release's published images rather than building them from
# SUBSTRATE_SRC (a source build also needs docker, for envoy-dataplane). Keep the
# tag in step with the SUBSTRATE_SRC checkout: the manifests still come from it.
export ATE_IMAGE_REPO=ghcr.io/agent-substrate/substrate
export ATE_IMAGE_TAG=v1.0.0

export PYTHON=python3                         # needs deploy/requirements.txt

# Substrate's ActorTemplate no longer accepts env.valueFrom.secretKeyRef, so the
# actor's model key cannot come from a Secret. It renders EMPTY by default, which
# is the intended state: with egress credential injection the actor calls the
# model with no credential and the plugin attaches one on the way out.
#
# Set this to 1 only for a cluster where egress injection is not live yet. It
# writes the key into the ActorTemplate in plaintext, where anyone who can read
# actortemplates can read it. Clear it once the plugin is running.
# export ACTOR_MODEL_KEY_INLINE=1

# Optional: the model API key, read into the hermes-secrets Secret.
# export MODEL_API_KEY_FILE=${HOME}/.config/hermes/model.key
