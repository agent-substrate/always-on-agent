cmd_reset_agent() {
  load_env
  # A fresh agent: delete the actor, and with it the DurableDir holding its
  # conversation history, memory and seeded briefing. The next message recreates
  # it from the golden snapshot, so it starts with exactly what the current image
  # ships and nothing it has learned since.
  #
  # Worth having as a command rather than a runbook: an agent that has answered
  # badly a few times will keep doing so, because its own transcript is in its
  # context and a model copies itself. Clearing that is a normal operation, not
  # an emergency one.
  say "clearing every actor in ${ATESPACE} (history, memory, seeded files)"
  local names
  names=$(kubectl exec -n "$NAMESPACE" deployment/hermes-gateway -- \
    kubectl-ate get actor -a "$ATESPACE" -o json 2>/dev/null \
    | ate_actor_states || true)
  if [[ -z "$names" ]]; then ok "no actors, already clean"; return 0; fi
  while read -r name status; do
    [[ -n "$name" ]] || continue
    [[ "$status" == "ACTOR_STATE_SUSPENDED" ]] || kubectl exec -n "$NAMESPACE" \
      deployment/hermes-gateway -- kubectl-ate suspend actor "$name" -a "$ATESPACE" \
      >/dev/null 2>&1 || true
  done <<<"$names"
  local tries=0
  while read -r name _; do
    [[ -n "$name" ]] || continue
    until kubectl exec -n "$NAMESPACE" deployment/hermes-gateway -- \
          kubectl-ate delete actor "$name" -a "$ATESPACE" >/dev/null 2>&1; do
      tries=$((tries + 1))
      [[ $tries -lt 30 ]] || { warn "could not delete ${name}"; break; }
      sleep 2
    done
    ok "cleared ${name}"
  done <<<"$names"
  say "the next message starts a brand-new agent (first turn is a cold start)"
}

cmd_doctor() {
  load_env
  say "checking the things that fail silently"


  # Reachability FIRST, and loudly. Every check below reads the cluster, and a
  # dead credential makes them all return empty, which this command then
  # reported as "actor template phase: missing", i.e. a healthy cluster
  # described as broken. An unreadable answer is not a negative answer.
  local err
  if ! err=$(kubectl get ns "$NAMESPACE" 2>&1); then
    warn "cannot reach the cluster, so nothing below can be checked:"
    sed 's/^/      /' <<<"$(head -3 <<<"$err")"
    if grep -qiE "reauth|auth plugin|credentials" <<<"$err"; then
      warn "this is a local credential problem, not a cluster problem:"
      warn "  gcloud auth login"
      warn "  gcloud container clusters get-credentials ${CLUSTER_NAME} \\"
      warn "    --location ${CLUSTER_LOCATION} --project ${PROJECT_ID}"
    fi
    return 1
  fi
  ok "cluster reachable"

  check_stray_gateway || true

  # atenet talks to every actor over mTLS with a certificate that lives about
  # 24 HOURS and is not rotated. When it lapses the workers correctly reject it,
  # atenet has no upstream, and the turn fails with a generic connect error that
  # is indistinguishable from a cold start that did not finish. The agent
  # then tells its user the connection was lost while it was waking up.
  #
  # Measured twice: valid until 2026-08-06T19:15:03Z after a restart at
  # 2026-08-05T19:15. Exactly 24h, no renewal.
  #
  # Read the WHOLE log, not the tail. Once the gateway gives up, traffic stops
  # and the errors scroll out of a `--tail` window, so a tail-based check
  # reports healthy on a cluster that has been unroutable for a day. That is
  # precisely what it did.
  # Only rejections logged AFTER the router last started count. The worker log
  # keeps the whole history, so an old incident otherwise reports as a current
  # outage forever, which is its own kind of lie.
  #
  # Logs go to a temp FILE and the path is passed as an argument. The obvious
  # shape, a python heredoc fed by a herestring, is two redirections on one
  # command, and bash silently gave the script no stdin, so this whole check
  # aborted and doctor printed nothing after it. A health check that stops
  # halfway without saying so is worse than no health check.
  local started logs
  started=$(kubectl get pods -n ate-system -l app=atenet-router \
            -o jsonpath='{.items[0].status.startTime}' 2>/dev/null)
  logs=$(mktemp)
  for w in $(kubectl get pods -n "$NAMESPACE" -l ate.dev/worker-pool=hermes \
             -o name 2>/dev/null); do
    kubectl logs -n "$NAMESPACE" "${w#pod/}" 2>/dev/null \
      | grep "certificate has expired" >> "$logs" || true
  done
  local verdict
  verdict=$("$PYTHON" -c '
import json, re, sys
started = sys.argv[1]
recent = []
for line in open(sys.argv[2]):
    try: d = json.loads(line)
    except Exception: continue
    if started and d.get("time", "") <= started: continue
    m = re.search(r"is after (\S+)", d.get("msg", ""))
    recent.append(m.group(1) if m else "?")
print(f"EXPIRED {recent[-1]} {len(recent)}" if recent else "OK")
' "$started" "$logs" 2>/dev/null || echo "UNKNOWN")
  rm -f "$logs"
  case "$verdict" in
    EXPIRED*)
      set -- $verdict
      warn "atenet's client certificate EXPIRED at $2, actors are unroutable"
      warn "($3 rejections since the router started at ${started:-unknown})"
      warn "fix: kubectl rollout restart deployment/atenet-router -n ate-system" ;;
    OK) ok "worker mTLS healthy, no rejections since the router started" ;;
    *)  warn "could not evaluate worker mTLS" ;;
  esac
  [[ -n "$started" ]] && say "atenet-router started ${started} (cert lifetime is ~24h)"

  # The template has no phase and no conditions any more: ActorTemplateStatus
  # carries goldenSnapshotStatus and nothing else. The old jsonpath did not
  # error, it returned empty, so this check reported "template may not exist"
  # against a perfectly healthy one.
  local golden
  if ! golden=$(kubectl-ate get actor-template hermes -a "$ATESPACE" -o json 2>&1); then
    warn "could not read the actor template: ${golden%%$'\n'*}"
  else
    golden=$(printf '%s' "$golden" | "$PYTHON" -c 'import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    print("unreadable"); sys.exit(0)
ts = d.get("actorTemplates") or ([d] if d.get("metadata") else [])
if not ts:
    print("missing"); sys.exit(0)
g = (ts[0].get("status") or {}).get("goldenSnapshotStatus") or {}
if g.get("errorMessage"):
    print("error", g["errorMessage"])
elif (g.get("goldenSnapshot") or {}).get("snapshotUri"):
    print("ready", g["goldenSnapshot"]["snapshotUri"])
else:
    print("pending")' || echo unreadable)
    case "$golden" in
      ready\ *)  ok "actor template ready, golden at ${golden#ready }" ;;
      error\ *)  warn "golden snapshot failed: ${golden#error }" ;;
      pending)   warn "actor template exists but its golden snapshot is not ready" ;;
      missing)   warn "no actor template in atespace ${ATESPACE}" ;;
      *)         warn "could not parse the actor template status" ;;
    esac
  fi
}

cmd_fleet() {
  load_env
  # Reads the gateway's own view rather than reassembling it here: the gateway
  # already holds the registry, the live control-plane state and the counters,
  # and a second implementation of that join would drift from the first.
  #
  # JSON goes to a temp FILE and the path is passed as an argument. Interpolating
  # it into a heredoc breaks on the first quote or dollar sign in the data, which
  # is how the first version of this failed.
  local pod tmp
  pod=$(kubectl get pod -n "$NAMESPACE" -l app=hermes-gateway \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [[ -n "$pod" ]] || die "no gateway pod, is it deployed?"
  tmp=$(mktemp)
  if ! kubectl exec -n "$NAMESPACE" "$pod" -- python -c \
       "import urllib.request;print(urllib.request.urlopen('http://127.0.0.1:8080/fleet').read().decode())" \
       > "$tmp" 2>/dev/null; then
    rm -f "$tmp"; die "could not read /fleet from the gateway"
  fi
  "$PYTHON" "${ROOT}/deploy/fleet_view.py" "$tmp"
  rm -f "$tmp"
}



cmd_logs() { load_env; kubectl logs -n "$NAMESPACE" deployment/hermes-gateway -f --tail=80; }

