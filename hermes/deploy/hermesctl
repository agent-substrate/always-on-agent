menu() {
  while true; do
    printf '\n%sHermes on Agent Substrate%s\n' "$C_H" "$C_X"
    echo "Commands: configure preflight cluster-up substrate-install build deploy"
    echo "          status smoke logs doctor fleet test-turn-signal"
    echo "          egress-status egress-on egress-off reset-agent cluster-down"
    read -rp "Command (q to quit): " c
    case "$c" in
      q|quit|exit) return ;;
      *) bash "$0" "$c" ;;
    esac
  done
}

# Load local configuration before dispatch.
[[ ! -f "$ENV_FILE" ]] || source "$ENV_FILE"

case "${1:-menu}" in
  menu) menu ;;
  configure) cmd_configure ;;                preflight) cmd_preflight ;;
  cluster-up) cmd_cluster_up ;;              cluster-down) cmd_cluster_down ;;
  substrate-install) cmd_substrate_install ;; build) cmd_build ;;
  deploy) cmd_deploy ;;                      status) cmd_status ;;
  smoke) cmd_smoke ;;                        logs) cmd_logs ;;
  reset-agent) cmd_reset_agent ;;            doctor) cmd_doctor ;;
  fleet) cmd_fleet ;;                        test-turn-signal) cmd_test_turn_signal ;;
  egress-on) cmd_egress_on ;;                egress-off) cmd_egress_off ;;
  egress-status) cmd_egress_status ;;      egress-plugin) cmd_egress_plugin ;;
  all)
    cmd_preflight; cmd_cluster_up; cmd_substrate_install
    cmd_build; cmd_deploy
    cmd_status ;;
  *) die "unknown command: $1 (run with no args for the menu)" ;;
esac
