# hermesctl: stand up Hermes agents on Agent Substrate, end to end.
#
# Nothing here is done by hand. Every step is a function you can run from the
# menu or call directly:  ./deploy/hermesctl <command>
#
# The steps are ordered and idempotent: re-running one is always safe, and the
# menu shows what is already done, so an interrupted session resumes rather than
# restarts.

set -o errexit -o nounset -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Overridable so a throwaway cluster can be driven from its own env file
# without editing the one that describes production.
ENV_FILE="${ENV_FILE:-${ROOT}/deploy/env.sh}"

C_OK=$'\033[0;32m'; C_NO=$'\033[0;31m'; C_WARN=$'\033[0;33m'
C_H=$'\033[1;36m'; C_DIM=$'\033[2m'; C_X=$'\033[0m'

say()  { printf '%s==>%s %s\n' "$C_H" "$C_X" "$*"; }
ok()   { printf '%s  ok%s %s\n' "$C_OK" "$C_X" "$*"; }
warn() { printf '%s  !!%s %s\n' "$C_WARN" "$C_X" "$*"; }
die()  { printf '%s  xx%s %s\n' "$C_NO" "$C_X" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# configuration
# ---------------------------------------------------------------------------

load_env() {
  # Substrate v1 always installs sdsmint, so every v1 cluster is an "sdsmint
  # cluster" for the egress commands below: egress-on would overwrite its
  # dataplane, and egress-plugin is the supported path.
  : "${EGRESS_SDSMINT:=1}"
  [[ -f "$ENV_FILE" ]] || die "no ${ENV_FILE}, run: $0 configure"
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  : "${PROJECT_ID:?set in deploy/env.sh}"
  CLUSTER_NAME="${CLUSTER_NAME:-hermes-agent}"
  CLUSTER_LOCATION="${CLUSTER_LOCATION:-us-central1-a}"
  MACHINE_TYPE="${MACHINE_TYPE:-e2-standard-2}"
  WORKER_REPLICAS="${WORKER_REPLICAS:-2}"
  BUCKET_NAME="${BUCKET_NAME:-hermes-snapshots-${PROJECT_ID}}"
  REGISTRY="${REGISTRY:-gcr.io/${PROJECT_ID}/hermes}"
  ATESPACE="${ATESPACE:-hermes}"
  NAMESPACE="${NAMESPACE:-hermes}"
  VERTEX_PROXY_ENABLED="${VERTEX_PROXY_ENABLED:-0}"
  VERTEX_PROJECT="${VERTEX_PROJECT:-$PROJECT_ID}"
  VERTEX_SERVICE_ACCOUNT="${VERTEX_SERVICE_ACCOUNT:-hermes-model@${PROJECT_ID}.iam.gserviceaccount.com}"
  if [[ "$VERTEX_PROXY_ENABLED" == "1" ]]; then
    # The actor speaks OpenAI-compatible HTTP only to the in-cluster bridge.
    # The bridge, not the actor, owns the Google authentication exchange.
    MODEL_PROVIDER=custom
    MODEL_BASE_URL=http://hermes-gateway.${NAMESPACE}.svc.cluster.local/model/v1
  fi
  # A data-backed Hermes resume can exceed Substrate's 5s parking default.
  # Real tool and model turns can also exceed the 10s route default.
  ATENET_PARKED_REQUEST_BUDGET="${ATENET_PARKED_REQUEST_BUDGET:-30s}"
  ATENET_ROUTE_TIMEOUT="${ATENET_ROUTE_TIMEOUT:-5m}"
  ATENET_DRAIN_TIMEOUT="${ATENET_DRAIN_TIMEOUT:-5m40s}"
  ATENET_TERMINATION_GRACE_SECONDS="${ATENET_TERMINATION_GRACE_SECONDS:-390}"
  PYTHON="${PYTHON:-python3}"
  local imports="import aiohttp, yaml" requirements="deploy/requirements.txt"
  if ! "$PYTHON" -c "$imports" >/dev/null 2>&1; then
    warn "${PYTHON} lacks deployment dependencies: pip install -r $requirements"
  fi
}


cmd_configure() {
  say "writing ${ENV_FILE}"
  local project
  read -rp "  GCP project id: " project
  mkdir -p "$(dirname "$ENV_FILE")"
  cat > "$ENV_FILE" <<EOF
# Generated by hermesctl configure. Safe to edit by hand.
export PROJECT_ID=${project}

# Cluster shape. Two small nodes is right for a pilot: GKE Sandbox requires a
# non-sandboxed pool for system pods, and one gVisor node hosts the workers.
export CLUSTER_NAME=hermes-agent
export CLUSTER_LOCATION=us-central1-a
export MACHINE_TYPE=e2-standard-2
# A worker holds ONE awake actor. This caps concurrency, not how many
# agents exist. Two is enough to watch one suspend and another take its
# place, which is the behaviour worth seeing.
export WORKER_REPLICAS=2

export BUCKET_NAME=hermes-snapshots-${project}
export REGISTRY=gcr.io/${project}/hermes
export ATESPACE=hermes
export NAMESPACE=hermes

# Model backend for the actors. Hermes talks to any OpenAI-compatible endpoint;
# \`custom\` plus a base_url is how you point it at one, and \`gemini\` is the other
# provider its entrypoint knows. Gemini here, matching demo/env.sh.example and
# demo/fleet/fleet.example.json. Pass 1 was measured on Gemini too, which is what
# makes the two passes' numbers comparable.
#
# Change the model host and you change EGRESS_ALLOW below with it. A mismatch
# denies every model call at request time rather than failing at startup.
export MODEL_DEFAULT=gemini-3.1-pro-preview
export MODEL_PROVIDER=gemini
export MODEL_BASE_URL=https://generativelanguage.googleapis.com

# Optional: keep Google credentials out of actors and snapshots by routing the
# OpenAI-compatible model call through the gateway, which authenticates to
# Vertex AI with GKE Workload Identity. hermesctl creates and binds the default
# service account when this is enabled. MODEL_PROVIDER and MODEL_BASE_URL are
# forced to the internal bridge; switch MODEL_PROXY_BACKEND on the Deployment to
# "openai" when a temporary rollback is needed.
# export VERTEX_PROXY_ENABLED=1
# export VERTEX_PROJECT=${project}
# export VERTEX_SERVICE_ACCOUNT=hermes-model@${project}.iam.gserviceaccount.com
# export VERTEX_MODEL=google/gemini-3.1-pro-preview
# export OPENAI_MODEL=gpt-5.6-luna

# Router budgets. A data-backed resume can exceed Substrate's default parked-
# request budget, and a real tool/model turn can exceed its route timeout.
# Drain/grace cover both so an upgrade does not discard an answer.
export ATENET_PARKED_REQUEST_BUDGET=30s
export ATENET_ROUTE_TIMEOUT=5m
export ATENET_DRAIN_TIMEOUT=5m40s
export ATENET_TERMINATION_GRACE_SECONDS=390
# Read at deploy time, never written into an image or this file:
#   export MODEL_API_KEY_FILE=\$HOME/.config/hermes/model.key
export MODEL_API_KEY_FILE=\${HOME}/.config/hermes/model.key

# Tunneled egress, off by default because that is what the cluster runs today.
# 0: actors get direct network access, nothing inspects or restricts it.
# 1: actor egress is tunneled through Substrate's egress gateway, which is what
#    makes per-actor destination policy possible. The gateway alone authenticates
#    the actor certificate and allows every destination.
# Needs a Substrate whose ate-api-server has --default-egress-gateway-address
# (main) or --egress-gateway-address (v0.1.0, v0.2.0).
# Applied by `hermesctl egress-on`, undone by `hermesctl egress-off`.
export HERMES_EGRESS=0

# Our destination policy plugin, on top of the gateway. Needs HERMES_EGRESS=1.
# This is the part that can block traffic, so it is its own switch.
export HERMES_EGRESS_PLUGIN=0

# What actors may reach when the plugin is on, space separated. Addresses, not
# hostnames: on a CONNECT the authority is the address the actor already
# resolved, so a hostname entry matches nothing. Empty means everything is
# denied. See egress-plugin/README.md.
export EGRESS_ALLOW=""
EOF
  chmod 600 "$ENV_FILE"
  ok "wrote ${ENV_FILE}"
  warn "next: $0 preflight"
}

# ---------------------------------------------------------------------------
# 1. preflight
# ---------------------------------------------------------------------------

# A competing local gateway can consume messages intended for the cluster.
check_stray_gateway() {
  local stray
  stray=$(pgrep -fl "ingress\.py" 2>/dev/null | grep -v pgrep || true)
  if [[ -n "$stray" ]]; then
    warn "a gateway is running on THIS MACHINE and will consume the same channel:"
    sed 's/^/      /' <<<"$stray"
    warn "kill it before testing, or replies will come from it at random:"
    warn "  pkill -f ingress.py"
    return 1
  fi
  ok "no local gateway competing for channel traffic"
}

cmd_preflight() {
  load_env
  local fail=0
  say "tooling"
  for t in gcloud kubectl docker; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t"; else warn "$t missing"; fail=1; fi
  done
  # The binary existing is not the same as the daemon running, and "docker: ok"
  # followed by a build failing on a missing socket is a waste of everyone's time.
  docker info >/dev/null 2>&1 && ok "docker daemon" \
    || { warn "docker daemon not running (colima start / open Docker Desktop)"; fail=1; }
  "$PYTHON" -c "import aiohttp, yaml" >/dev/null 2>&1 \
    && ok "python deps ($PYTHON)" || { warn "python deps missing in $PYTHON"; fail=1; }
  command -v ko >/dev/null 2>&1 && ok "ko" || warn "ko missing (needed to build Substrate images)"
  check_stray_gateway || true

  say "credentials"
  [[ -f "${MODEL_API_KEY_FILE:-}" ]] && ok "model key" || warn "no model key at ${MODEL_API_KEY_FILE:-unset}"

  say "gcp"
  gcloud projects describe "$PROJECT_ID" >/dev/null 2>&1 \
    && ok "project $PROJECT_ID" || { warn "cannot read project $PROJECT_ID"; fail=1; }
  command -v go >/dev/null 2>&1 && ok "go (setup-gcp is a Go program)" \
    || { warn "go missing, needed by Substrate's provisioner"; fail=1; }
  # setup-gcp uses the Google client libraries, which read ADC rather than the
  # gcloud CLI session. They are separate credentials and both must be valid.
  if gcloud auth application-default print-access-token >/dev/null 2>&1
  then ok "application-default credentials"
  else warn "no usable ADC, run: gcloud auth application-default login --project=${PROJECT_ID}"; fail=1
  fi

  [[ $fail -eq 0 ]] && ok "preflight clean" || warn "preflight has gaps (above)"
  return "$fail"
}

# ---------------------------------------------------------------------------
# 2. cluster
# ---------------------------------------------------------------------------

cluster_exists() {
  gcloud container clusters describe "$CLUSTER_NAME" --location "$CLUSTER_LOCATION" \
    --project "$PROJECT_ID" >/dev/null 2>&1
}

cmd_cluster_up() {
  load_env
  local src="${SUBSTRATE_SRC:-${ROOT}/../substrate}"
  [[ -d "$src" ]] || die "Substrate source not found at ${src} (set SUBSTRATE_SRC)"
  command -v go >/dev/null 2>&1 || die "go is required: setup-gcp is a Go program"

  # Substrate ships its own provisioner and it is the source of truth. Hand-rolled
  # gcloud commands miss things that only fail much later and confusingly: the
  # v1beta1 certificates APIs (podcertificaterequests + clustertrustbundles) that
  # podcertcontroller blocks on forever without, Workload Identity (atelet has no
  # identity without it), and the IAM that lets atelet WRITE SNAPSHOTS AT ALL ,
  # miss that one and everything looks healthy until suspend/resume silently does
  # not work. It is idempotent, so re-running is free.

  # setup-gcp moved out of the Substrate repo at v1.0.0 into the GKE installer
  # repo. Pinned to a commit so a re-run builds the same tool; bump SETUP_GCP_REF
  # (a commit or tag of github.com/ai-on-gke/substrate-gke) to move it.
  local setup_gcp="github.com/ai-on-gke/substrate-gke/tools/setup-gcp@${SETUP_GCP_REF:-3827792e16f9082e87c9bf610e5df8d4b9bc5767}"
  say "provisioning via setup-gcp bootstrap (${setup_gcp##*@})"
  local project_number
  project_number=$(gcloud projects describe "$PROJECT_ID" --format="value(projectNumber)")
  # Nested virtualization is on by default, for micro-VM workers. Hermes runs on
  # gVisor, and the control/gateway machine type (e2) cannot take it.
  PROJECT_ID="$PROJECT_ID" PROJECT_NUMBER="$project_number" \
  CLUSTER_NAME="$CLUSTER_NAME" CLUSTER_LOCATION="$CLUSTER_LOCATION" \
  GCE_REGION="${CLUSTER_LOCATION%-*}" BUCKET_NAME="$BUCKET_NAME" \
    go run "$setup_gcp" bootstrap \
      --project-id="$PROJECT_ID" --project-number="$project_number" \
      --bucket-name="$BUCKET_NAME" --cluster-name="$CLUSTER_NAME" \
      --cluster-location="$CLUSTER_LOCATION" --machine-type="$MACHINE_TYPE" \
      --enable-nested-virtualization=false

  gcloud container clusters get-credentials "$CLUSTER_NAME" \
    --location "$CLUSTER_LOCATION" --project "$PROJECT_ID"

  say "container registry for our own images"
  # setup-gcp creates the cluster and bucket but not a Docker repo for the actor
  # and gateway images we build ourselves.
  local ar_loc="${CLUSTER_LOCATION%-*}" ar_name="${REGISTRY##*/}"
  gcloud artifacts repositories describe "$ar_name" --location "$ar_loc" \
    --project "$PROJECT_ID" >/dev/null 2>&1 \
    || gcloud artifacts repositories create "$ar_name" --repository-format=docker \
         --location "$ar_loc" --project "$PROJECT_ID"
  # Without Docker, `build` uses Cloud Build, which pushes as the project's default
  # compute service account. A new repo inherits no write access for it (grants
  # made at project level do not reach it), so the build succeeds and the push
  # fails. Grant it on this repo only.
  local project_number
  project_number=$(gcloud projects describe "$PROJECT_ID" --format="value(projectNumber)")
  gcloud artifacts repositories add-iam-policy-binding "$ar_name" \
    --location "$ar_loc" --project "$PROJECT_ID" \
    --member="serviceAccount:${project_number}-compute@developer.gserviceaccount.com" \
    --role=roles/artifactregistry.writer --condition=None >/dev/null
  # setup-gcp gives the nodes their own service account (ate-gke-node) with read
  # on Substrate's image repository only. The gateway is an ordinary Deployment
  # the nodes pull, and atelet pulls the actor image, so both need read here too,
  # or the gateway sits in ErrImagePull with a failed oauth token.
  local member
  for member in \
      "serviceAccount:ate-gke-node@${PROJECT_ID}.iam.gserviceaccount.com" \
      "principal://iam.googleapis.com/projects/${project_number}/locations/global/workloadIdentityPools/${PROJECT_ID}.svc.id.goog/subject/ns/ate-system/sa/atelet"; do
    gcloud artifacts repositories add-iam-policy-binding "$ar_name" \
      --location "$ar_loc" --project "$PROJECT_ID" --member="$member" \
      --role=roles/artifactregistry.reader --condition=None >/dev/null
  done
  gcloud auth configure-docker "${ar_loc}-docker.pkg.dev" --quiet >/dev/null 2>&1

  say "worker node pool"
  # Workers need their OWN pool, and the machine family is load-bearing, not a
  # preference. gVisor's runsc restore rejects a checkpoint whose CPUID feature
  # set is not a subset of the restoring host, so a family with no CPU-platform
  # guarantee (e2) silently produces unrestorable snapshots the moment a node is
  # recycled onto different silicon. c2d is AMD Milan only.
  #
  # The pool is TAINTED, and this reverses what used to be written here ("do NOT
  # taint: the atelet DaemonSet carries no tolerations, and without an atelet on
  # the node every restore fails at CallAteletRestore"). atelet tolerates
  # ate.dev/sandboxClass Exists as of release-0.1, and WorkerPool passes
  # tolerations through to its worker pods, so both halves are covered.
  #
  # Untainted, the Substrate control plane schedules straight onto the worker
  # nodes: on the pass 2 install, Postgres, both API servers, the controller,
  # the DNS pod and both routers all landed there. Postgres serves the
  # worker-watch change feed on a polling loop, so it is busiest at exactly the
  # moment a burst wake is being measured, which is the measurement pass 2 is
  # for. Tainting at CREATE time also avoids the eviction dance: NoSchedule does
  # not move what is already running, so retrofitting the taint means deleting
  # every control-plane pod by hand.
  #
  # cmd_deploy re-checks the atelet toleration against the live cluster before
  # applying the WorkerPool, because getting this wrong is silent.
  local worker_machine="${WORKER_MACHINE_TYPE:-c2d-standard-4}"
  gcloud container node-pools describe substrate-workers --cluster "$CLUSTER_NAME" \
    --zone "$CLUSTER_LOCATION" --project "$PROJECT_ID" >/dev/null 2>&1 \
    || gcloud container node-pools create substrate-workers \
         --cluster "$CLUSTER_NAME" --zone "$CLUSTER_LOCATION" --project "$PROJECT_ID" \
         --machine-type "$worker_machine" --num-nodes "${WORKER_NODES:-1}" \
         --image-type COS_CONTAINERD --disk-type pd-balanced --disk-size 100 \
         --workload-metadata=GKE_METADATA \
         --node-taints=ate.dev/sandboxClass=gvisor:NoSchedule \
         --node-labels=substrate.ate.dev/worker=true --scopes=gke-default

  # NOTE: no gVisor node pool and no Google CAS pools. Substrate fetches its own
  # runsc binary (see manifests/ate-install/sandboxconfig-gvisor.yaml) rather than
  # using GKE Sandbox, and its CA pools are self-signed Kubernetes secrets made by
  # `kubectl ate admin make-ca-pool`, not Certificate Authority Service.
  ok "cluster ready"
}

cmd_cluster_down() {
  load_env
  read -rp "delete cluster ${CLUSTER_NAME} and bucket ${BUCKET_NAME}? [y/N] " a
  [[ "$a" == "y" ]] || return 0
  gcloud container clusters delete "$CLUSTER_NAME" --location "$CLUSTER_LOCATION" \
    --project "$PROJECT_ID" --quiet || true
  gcloud storage rm -r "gs://${BUCKET_NAME}" --project "$PROJECT_ID" 2>/dev/null || true
  ok "torn down (an idle cluster bills; a deleted one does not)"
}

# ---------------------------------------------------------------------------
# 3. substrate
# ---------------------------------------------------------------------------

# The turn-signal plugin decides whether an actor is suspended on top of running
# work, and the part that can only be wrong on Linux, does walking /proc
# actually find a process the agent backgrounded, cannot be covered by the
# offline suite on a developer's Mac. So run the plugin unmodified, against a
# real /proc, with real child processes. The gateway pod is used purely as a
# convenient Linux host: nothing is installed and nothing is left behind.
cmd_test_turn_signal() {
  load_env
  local pod
  pod=$(kubectl get pod -n "$NAMESPACE" -l app=hermes-gateway \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [[ -n "$pod" ]] || die "no gateway pod, is it deployed?"
  say "running the turn-signal plugin against a real /proc in ${pod}"
  kubectl cp "${ROOT}/actor/plugins/turn-signal/__init__.py" \
    "${NAMESPACE}/${pod}:/tmp/turn_signal.py" >/dev/null 2>&1 \
    || die "could not copy the plugin into the pod"
  kubectl cp "${ROOT}/deploy/test_turn_signal.py" \
    "${NAMESPACE}/${pod}:/tmp/test_turn_signal.py" >/dev/null 2>&1 \
    || die "could not copy the test into the pod"
  local rc=0
  kubectl exec -n "$NAMESPACE" "$pod" -- \
    python /tmp/test_turn_signal.py /tmp/turn_signal.py || rc=$?
  kubectl exec -n "$NAMESPACE" "$pod" -- \
    rm -f /tmp/turn_signal.py /tmp/test_turn_signal.py >/dev/null 2>&1 || true
  [[ $rc -eq 0 ]] || die "turn-signal checks failed"
  ok "turn-signal verified on Linux"
}

# ---- tunneled egress ------------------------------------------------------
#
# Two switches, because they fail differently. HERMES_EGRESS routes actor egress
# through Substrate's gateway, which authenticates the actor certificate and
# allows every destination, so turning it on should not change what Hermes can
# reach. HERMES_EGRESS_PLUGIN adds our destination policy on top, which is the
# part that can actually block traffic. Either can be turned off on its own.

EGRESS_GW_ADDR="atenet-egress.ate-system.svc:443"

# Does this cluster's control plane know how to tunnel egress at all? Checked
# before anything is changed, so an unsupported cluster gets a clear message
# rather than a crash looping api server.
#
# Substrate main renamed the flag to --default-egress-gateway-address (#1858)
# with no alias, and an api server given the old name will not start. v0.1.0
# and v0.2.0 only know the old name. egress_flag_name prints whichever one this
# cluster's api server accepts, and nothing if it accepts neither.
EGRESS_FLAG_RE='--(default-)?egress-gateway-address'

egress_flag_name() {
  local pod help
  pod=$(kubectl get pod -n ate-system -l app=ate-api-server \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || return 1
  [[ -n "$pod" ]] || return 1
  help=$(kubectl exec -n ate-system "$pod" -- /ko-app/ateapi --help 2>&1) || true
  if grep -q -- "--default-egress-gateway-address" <<<"$help"; then
    echo "--default-egress-gateway-address"
  elif grep -q -- "--egress-gateway-address" <<<"$help"; then
    echo "--egress-gateway-address"
  else
    return 1
  fi
}

egress_supported() {
  egress_flag_name >/dev/null
}

# These commands change a cluster wide setting, and hermesctl uses whatever kube
# context happens to be current. Name the target out loud and refuse a context
# that does not look like the configured cluster.
egress_target() {
  local ctx
  ctx=$(kubectl config current-context 2>/dev/null) || die "no current kube context"
  say "target cluster: ${ctx}"
  if [[ "${ALLOW_ANY_CLUSTER:-0}" != "1" && "$ctx" != *"${CLUSTER_NAME}"* ]]; then
    die "context ${ctx} does not look like ${CLUSTER_NAME}. Switch context, or set
    ALLOW_ANY_CLUSTER=1 if you meant to change this one."
  fi
}

egress_flag_set() {
  kubectl get deploy ate-api-server -n ate-system \
    -o jsonpath='{.spec.template.spec.containers[0].args}' 2>/dev/null \
    | grep -qE -- "$EGRESS_FLAG_RE"
}

egress_plugin_svc() {
  printf 'hermes-egress-plugin.%s.svc.cluster.local:50051' "${NAMESPACE:?load_env first}"
}

egress_wired() {
  kubectl get cm atenet-egress -n ate-system -o jsonpath='{.data.envoy\.yaml}' 2>/dev/null \
    | "$PYTHON" "${ROOT}/deploy/egress_filter.py" status >/dev/null 2>&1
}

# One "<name> <state>" line per actor, read from `get actor -o json` on stdin.
#
# There are three callers and they used to carry three copies of this, which is
# how two of them ended up still reading a shape the control plane stopped
# emitting. Both shapes are accepted here, once:
#
#   old   {"actors": [{"metadata": {...}, "status": "STATUS_RUNNING"}]}
#   new   {"actors": [{"metadata": {...}, "status": {"state": "ACTOR_STATE_RUNNING"}}]}
#
# The old reader does not fail on the new shape, it prints a dict where a state
# should be. `read -r name state` then takes "{'state':" as the state, which
# equals nothing, so every "is it already suspended?" test answers no and every
# actor gets suspended redundantly on the way to being deleted. Slow and
# confusing rather than wrong, but the same misread in the gateway is what made
# wait_running() burn its full timeout on every resume.
#
# States are normalised to the ACTOR_STATE_* spelling so callers compare against
# one vocabulary.
ate_actor_states() {
  "$PYTHON" -c 'import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for a in d.get("actors", []):
    name = (a.get("metadata") or {}).get("name")
    if not name:
        continue
    status = a.get("status")
    state = status.get("state", "") if isinstance(status, dict) else (status or "")
    if state.startswith("STATUS_"):
        state = "ACTOR_STATE_" + state[len("STATUS_"):]
    print(name, state or "ACTOR_STATE_UNSPECIFIED")'
}

# Actors are told the gateway address when they are resumed, so a change only
# takes effect after a suspend and resume.
egress_restart_actors() {
  # errexit is on, so the failure has to be caught in the same list as the
  # assignment. `raw=$(...); rc=$?` would abort the script before rc is read.
  local actors a raw rc=0
  # JSON rather than the table. The table's column order is not a contract and
  # the name moved once already; picking $2 out of it fails by cycling the wrong
  # thing, silently, which is worse than not cycling at all.
  raw=$(kubectl-ate get actor -a "$ATESPACE" -o json 2>&1) || rc=$?
  if [[ $rc -ne 0 ]]; then
    warn "could not list actors: ${raw%%$'\n'*}"
    warn "the egress setting is applied when an actor is resumed, so any actor"
    warn "already running is STILL ON THE OLD SETTING. Cycle it by hand:"
    warn "  kubectl-ate suspend actor <name> -a ${ATESPACE}"
    warn "  kubectl-ate resume  actor <name> -a ${ATESPACE}"
    return 0
  fi
  actors=$(printf '%s\n' "$raw" | ate_actor_states | awk '{print $1}')
  [[ -n "$actors" ]] || { warn "no actors to cycle"; return 0; }
  for a in $actors; do
    say "cycling actor ${a} so it picks up the new egress setting"
    kubectl-ate suspend actor "$a" -a "$ATESPACE" >/dev/null 2>&1 || true
    kubectl-ate resume  actor "$a" -a "$ATESPACE" >/dev/null 2>&1 || true
  done
}

# EGRESS_ALLOW becomes the registry's defaults, so every actor gets it without
# the file having to name them. Deliberate: listing actors is not reliable
# (kubectl-ate currently fails to unmarshal a running actor), and a registry
# built from a failed listing would silently name nobody and quarantine
# everything. Per actor lists are still the point of the plugin, and go in the
# agents map once there is a reason to differ.
#
# EGRESS_ALLOW is COMMA-separated. Splitting it on whitespace instead is not a
# parse error, which is what makes it expensive: it yields a registry whose one
# allowed "host" is the entire 78-character string, so it matches nothing, every
# actor is denied every destination, and inside the sandbox that arrives as an
# HTTP 403 from the model provider naming a host that is plainly in the list the
# operator configured.
egress_render_registry() {
  ALLOW="${EGRESS_ALLOW:-}" "$PYTHON" <<'PYEOF'
import json, os, re
hosts = [h.strip() for h in re.split(r"[,\s]+", os.environ.get("ALLOW", ""))]
print(json.dumps({"defaults": [h for h in hosts if h], "agents": {}}, indent=2))
PYEOF
}

# ---------------------------------------------------------------------------
# egress plugin, on a cluster installed with the extproc flag
#
# Separate from `egress-on` on purpose. egress-on predates
# --experimental-additional-egress-extproc-service: it applies the NON-sdsmint
# atenet-egress.yaml and patches Envoy itself through deploy/egress_filter.py.
# Run against a cluster installed with EGRESS_SDSMINT=1 it would overwrite the
# sdsmint dataplane with one that has no MITM leg and no trust bundle, which
# stops every actor from starting. So egress-on refuses, and this does the half
# that is still needed: build the plugin, and deploy it.
# ---------------------------------------------------------------------------

cmd_egress_plugin() {
  load_env
  [[ "${EGRESS_SDSMINT:-0}" == "1" ]] || die "egress-plugin is for a cluster installed with
    EGRESS_SDSMINT=1 and EGRESS_EXTPROC_SERVICE set. This one is not; use egress-on."
  kubectl get cm atenet-egress -n ate-system -o jsonpath='{.data.envoy\.yaml}' 2>/dev/null \
    | grep -q 'additional_egress_ext_proc' \
    || die "the installed Envoy has no additional_egress_ext_proc cluster, so nothing
    would call this plugin. The cluster was installed without
    --experimental-additional-egress-extproc-service; that is an install-time flag
    and cannot be added afterwards."

  say "building the egress plugin image (linux/amd64)"
  egress_plugin_stage_binary
  image_build "${ROOT}/egress-plugin" "${REGISTRY}/hermes-egress-plugin:latest"
  local pinned
  pinned="${REGISTRY}/hermes-egress-plugin@$(image_digest "${REGISTRY}/hermes-egress-plugin:latest")"
  ok "plugin ${pinned##*@}"

  [[ -n "${EGRESS_ALLOW:-}" ]] || warn "EGRESS_ALLOW is empty, so every actor is
    quarantined and Hermes will not reach anything"

  # The plugin has to be up BEFORE the first actor, because the extproc filter is
  # fail-closed against it, so on a fresh cluster this runs before `deploy` and the
  # namespace does not exist yet. Creating it here rather than making the order
  # deploy-then-plugin, which would open a window where every actor's egress 500s.
  kubectl create namespace "$NAMESPACE" >/dev/null 2>&1 || true

  egress_render_registry > /tmp/hermes-egress-registry.json
  kubectl create configmap egress-registry -n "$NAMESPACE" \
    --from-file=registry.json=/tmp/hermes-egress-registry.json \
    --dry-run=client -o yaml | kubectl apply -f -

  say "deploying the plugin"
  sed "s|REPLACE_WITH_EGRESS_PLUGIN_IMAGE|${pinned}|" \
    "${ROOT}/egress-plugin/k8s/egress-plugin.yaml" | kubectl apply -f -
  # Restart even when nothing in the manifest moved: the registry ConfigMap is
  # read at startup, so a changed allowlist is otherwise applied to nothing.
  kubectl rollout restart deploy/hermes-egress-plugin -n "$NAMESPACE"
  kubectl rollout status  deploy/hermes-egress-plugin -n "$NAMESPACE" --timeout=180s
  ok "egress plugin up. Until this rollout completed, NO actor could reach the network:
    the filter is failure_mode_allow: false."
}

cmd_egress_status() {
  load_env
  say "tunneled egress"
  if egress_supported; then
    ok "this Substrate supports tunneled egress ($(egress_flag_name))"
  else
    warn "this Substrate has no egress gateway address flag, so tunneled egress"
    warn "cannot be turned on here without upgrading Substrate first"
  fi
  if kubectl get deploy atenet-egress -n ate-system >/dev/null 2>&1; then
    ok "egress gateway is deployed"
  else
    warn "no egress gateway deployed (deployment/atenet-egress in ate-system)"
  fi
  if egress_flag_set; then
    ok "control plane points at the gateway, so actor egress is tunneled"
  else
    warn "control plane has no gateway address, so actors have direct egress"
  fi
  say "destination policy"
  if kubectl get deploy hermes-egress-plugin -n "$NAMESPACE" >/dev/null 2>&1; then
    ok "plugin is deployed"
  else
    warn "plugin is not deployed"
  fi
  if egress_wired; then
    ok "plugin is wired into the egress chain"
    kubectl get cm egress-registry -n "$NAMESPACE" \
      -o jsonpath='{.data.registry\.json}' 2>/dev/null | sed 's/^/    /'
  else
    warn "plugin is not wired into the egress chain"
  fi
}

cmd_egress_on() {
  load_env
  egress_target
  [[ "${HERMES_EGRESS:-0}" == "1" ]] || die "HERMES_EGRESS is not 1 in deploy/env.sh.
    Set it there rather than passing it here, so the file matches the cluster."
  # This path applies the non-sdsmint dataplane and hand-patches Envoy. On an
  # sdsmint cluster that replaces the MITM leg and the trust bundle the actor
  # template depends on, and every actor then fails to start. Not recoverable by
  # re-running the install, because the ActorTemplate is immutable.
  [[ "${EGRESS_SDSMINT:-0}" != "1" ]] || die "this cluster was installed with
    EGRESS_SDSMINT=1, and egress-on would overwrite its egress dataplane with the
    non-sdsmint one -- removing the MITM leg and the trust bundle every actor
    template references. The installer already did everything here except the
    plugin. Run 'hermesctl egress-plugin' instead."
  egress_supported || die "this cluster's ate-api-server has no egress gateway address flag.
    Tunneled egress landed in a later Substrate than the one installed here, so this
    needs a Substrate upgrade first. Nothing has been changed."

  if ! kubectl get deploy atenet-egress -n ate-system >/dev/null 2>&1; then
    local src="${SUBSTRATE_SRC:-${ROOT}/../substrate}"
    [[ -d "$src" ]] || die "no egress gateway deployed, and no Substrate source at ${src}"
    say "deploying the egress gateway"
    kubectl apply -f "${src}/manifests/ate-install/atenet-egress.yaml"
  fi
  kubectl rollout status deploy/atenet-egress -n ate-system --timeout=180s

  if [[ "${HERMES_EGRESS_PLUGIN:-0}" == "1" ]]; then
    say "deploying the destination policy plugin"
    [[ -n "${EGRESS_ALLOW:-}" ]] || warn "EGRESS_ALLOW is empty, so every actor is
    quarantined and Hermes will not reach anything"
    kubectl create namespace "$NAMESPACE" >/dev/null 2>&1 || true
    egress_render_registry > /tmp/hermes-egress-registry.json
    kubectl create configmap egress-registry -n "$NAMESPACE" \
      --from-file=registry.json=/tmp/hermes-egress-registry.json \
      --dry-run=client -o yaml | kubectl apply -f -
    sed "s|REPLACE_WITH_EGRESS_PLUGIN_IMAGE|${REGISTRY}/hermes-egress-plugin:latest|" \
      "${ROOT}/egress-plugin/k8s/egress-plugin.yaml" | kubectl apply -f -
    kubectl rollout status deploy/hermes-egress-plugin -n "$NAMESPACE" --timeout=180s

    say "wiring the plugin into the egress chain"
    kubectl get cm atenet-egress -n ate-system -o jsonpath='{.data.envoy\.yaml}' \
      | "$PYTHON" "${ROOT}/deploy/egress_filter.py" add --service "$(egress_plugin_svc)" \
      > /tmp/hermes-envoy.yaml
    kubectl create cm atenet-egress -n ate-system \
      --from-file=envoy.yaml=/tmp/hermes-envoy.yaml --dry-run=client -o yaml | kubectl apply -f -
    kubectl rollout restart deploy/atenet-egress -n ate-system
    kubectl rollout status  deploy/atenet-egress -n ate-system --timeout=180s
  fi

  say "pointing the control plane at the gateway"
  local flag
  flag=$(egress_flag_name)
  egress_flag_set || kubectl patch deploy ate-api-server -n ate-system --type=json \
    -p "[{\"op\":\"add\",\"path\":\"/spec/template/spec/containers/0/args/-\",\"value\":\"${flag}=${EGRESS_GW_ADDR}\"}]"
  kubectl rollout status deploy/ate-api-server -n ate-system --timeout=180s

  egress_restart_actors
  cmd_egress_status
  ok "actor egress is tunneled. Run 'hermesctl smoke' to confirm Hermes still answers."
}

cmd_egress_off() {
  load_env
  egress_target
  # Order matters. The filter is configured failure_mode_allow: false, so while
  # it is still in the chain with its backend gone, every egress request is
  # denied. Take the filter out and let Envoy finish reloading FIRST, then
  # delete the plugin. Doing it the other way around causes an outage during
  # the undo, which is the worst possible time for one.
  say "unwiring the plugin from the egress chain"
  if kubectl get cm atenet-egress -n ate-system >/dev/null 2>&1; then
    kubectl get cm atenet-egress -n ate-system -o jsonpath='{.data.envoy\.yaml}' \
      | "$PYTHON" "${ROOT}/deploy/egress_filter.py" remove > /tmp/hermes-envoy.yaml
    kubectl create cm atenet-egress -n ate-system \
      --from-file=envoy.yaml=/tmp/hermes-envoy.yaml --dry-run=client -o yaml | kubectl apply -f -
    kubectl rollout restart deploy/atenet-egress -n ate-system
    kubectl rollout status  deploy/atenet-egress -n ate-system --timeout=180s
  fi

  say "removing the plugin"
  # By name, never by namespace: the plugin shares the Hermes namespace and
  # deleting that would take Hermes with it.
  kubectl delete -n "$NAMESPACE" --ignore-not-found \
    deploy/hermes-egress-plugin svc/hermes-egress-plugin \
    sa/hermes-egress-plugin cm/egress-registry

  say "removing the gateway address from the control plane"
  "$PYTHON" - <<'PYEOF' > /tmp/hermes-args.json
import json, subprocess
raw = subprocess.run(["kubectl", "get", "deploy", "ate-api-server", "-n", "ate-system",
                      "-o", "jsonpath={.spec.template.spec.containers[0].args}"],
                     capture_output=True, text=True).stdout
args = json.loads(raw) if raw.strip() else []
print(json.dumps([a for a in args
                  if not a.startswith(("--egress-gateway-address", "--default-egress-gateway-address"))]))
PYEOF
  kubectl patch deploy ate-api-server -n ate-system --type=json \
    -p "[{\"op\":\"replace\",\"path\":\"/spec/template/spec/containers/0/args\",\"value\":$(cat /tmp/hermes-args.json)}]"
  kubectl rollout status deploy/ate-api-server -n ate-system --timeout=180s

  egress_restart_actors
  cmd_egress_status
  ok "actors are back on direct egress. Run 'hermesctl smoke' to confirm."
}

configure_atenet_router_budgets() {
  local raw patch
  raw=$(kubectl get deployment atenet-router -n ate-system -o json)
  patch=$("$PYTHON" - "$raw" \
    "$ATENET_PARKED_REQUEST_BUDGET" "$ATENET_ROUTE_TIMEOUT" \
    "$ATENET_DRAIN_TIMEOUT" "$ATENET_TERMINATION_GRACE_SECONDS" <<'PYEOF'
import json
import sys

deployment = json.loads(sys.argv[1])
args = deployment["spec"]["template"]["spec"]["containers"][0].get("args", [])
settings = (
    ("--parked-request-budget=", sys.argv[2]),
    ("--route-timeout=", sys.argv[3]),
    ("--drain-timeout=", sys.argv[4]),
)
for prefix, value in settings:
    args = [arg for arg in args if not arg.startswith(prefix)]
    args.append(prefix + value)

print(json.dumps([
    {
        "op": "replace",
        "path": "/spec/template/spec/containers/0/args",
        "value": args,
    },
    {
        "op": "add",
        "path": "/spec/template/spec/terminationGracePeriodSeconds",
        "value": int(sys.argv[5]),
    },
]))
PYEOF
  )

  say "configuring atenet-router wake, turn, and shutdown budgets"
  kubectl patch deployment atenet-router -n ate-system --type=json -p "$patch"
  kubectl rollout status deployment/atenet-router -n ate-system --timeout=420s
  ok "atenet-router: park ${ATENET_PARKED_REQUEST_BUDGET}, route ${ATENET_ROUTE_TIMEOUT}, drain ${ATENET_DRAIN_TIMEOUT}"
}

